<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Hospital_Enquiry_Standalone" targetNamespace="https://hospital.example/core" exporter="Camunda Modeler" exporterVersion="5.51.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:collaboration id="Collaboration_Hospital_Enquiry_Standalone">
    <bpmn:participant id="Pool_Hospital_Enquiry_Standalone" name="07 Patient enquiry and clinical triage — standalone" processRef="Hospital_Enquiry_Standalone" />
    <bpmn:participant id="Participant_ExternalEnquiry" name="Patient / external enquiry source" />
    <bpmn:messageFlow id="MessageFlow_ExternalEnquiry_Received" name="Patient enquiry received (standalone)" sourceRef="Participant_ExternalEnquiry" targetRef="Q_Start" messageRef="Q_Start_Message">
      <bpmn:documentation>The external enquiry message worker publishes this message to Camunda with a unique correlation key and synthetic patient data. The message start event creates a new Hospital_Enquiry_Standalone instance. Manual Tasklist starts use Q_Manual instead.</bpmn:documentation>
    </bpmn:messageFlow>
  </bpmn:collaboration>
  <bpmn:process id="Hospital_Enquiry_Standalone" name="07 Patient enquiry and clinical triage — standalone" isExecutable="true">
    <bpmn:documentation>Local executable case-study demonstration. Clinical and financial authority is represented by role lanes and recorded actor fields. Production IAM and real external integrations must be configured separately. Demo scenarios use synthetic patient data only.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_Hospital_Enquiry_Standalone">
      <bpmn:lane id="Hospital_Enquiry_Standalone_Lane_0" name="Call Handling Team">
        <bpmn:flowNodeRef>Q_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_Manual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_Record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_Type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_Admin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_Appointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_Resolved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Hospital_Enquiry_Standalone_Lane_1" name="Finance Team">
        <bpmn:flowNodeRef>Q_Finance</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Hospital_Enquiry_Standalone_Lane_2" name="Clinical Nurse Specialist Team">
        <bpmn:flowNodeRef>Q_Triage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_Urgent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_UrgentResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_Clinical</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Hospital_Enquiry_Standalone_Lane_3" name="Hospital system / Java workers">
        <bpmn:flowNodeRef>Q_Init</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Q_Start" name="Patient enquiry received (standalone)">
      <bpmn:outgoing>Hospital_Enquiry_Standalone_F_Q_Start_Q_Init</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Q_Start_Message" />
    </bpmn:startEvent>
    <bpmn:startEvent id="Q_Manual" name="Register enquiry manually">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="h-enquiry-intake" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Hospital_Enquiry_Standalone_F_Q_Manual_Q_Init</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Q_Init" name="Identify patient and enquiry">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="hospital.enquiry.initialize" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Hospital_Enquiry_Standalone_F_Q_Start_Q_Init</bpmn:incoming>
      <bpmn:incoming>Hospital_Enquiry_Standalone_F_Q_Manual_Q_Init</bpmn:incoming>
      <bpmn:outgoing>Hospital_Enquiry_Standalone_F_Q_Init_Q_Record</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Q_Record" name="Record, classify and assign priority">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="h-enquiry-intake" bindingType="deployment" />
        <zeebe:taskHeaders>
          <zeebe:header key="requiredRole" value="Call Handling Team" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:output source="=patientId" target="patientId" />
          <zeebe:output source="=enquiryType" target="enquiryType" />
          <zeebe:output source="=enquiryPriority" target="enquiryPriority" />
          <zeebe:output source="=enquirySummary" target="enquirySummary" />
          <zeebe:output source="=enquiryHandlerId" target="enquiryHandlerId" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Hospital_Enquiry_Standalone_F_Q_Init_Q_Record</bpmn:incoming>
      <bpmn:incoming>Q_F_Unresolved</bpmn:incoming>
      <bpmn:outgoing>Hospital_Enquiry_Standalone_F_Q_Record_Q_Type</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Q_Type" name="Enquiry type?" default="F_Enquiry_Clinical">
      <bpmn:incoming>Hospital_Enquiry_Standalone_F_Q_Record_Q_Type</bpmn:incoming>
      <bpmn:outgoing>F_Enquiry_Admin</bpmn:outgoing>
      <bpmn:outgoing>F_Enquiry_Appointment</bpmn:outgoing>
      <bpmn:outgoing>F_Enquiry_Funding</bpmn:outgoing>
      <bpmn:outgoing>F_Enquiry_Clinical</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Q_Admin" name="Answer authorised administrative question">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="h-enquiry-response" bindingType="deployment" />
        <zeebe:taskHeaders>
          <zeebe:header key="requiredRole" value="Call Handling Team" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=false" target="enquiryResolved" />
          <zeebe:output source="=enquiryResponse" target="enquiryResponse" />
          <zeebe:output source="=responseStaffId" target="responseStaffId" />
          <zeebe:output source="=enquiryResolved" target="enquiryResolved" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F_Enquiry_Admin</bpmn:incoming>
      <bpmn:outgoing>Hospital_Enquiry_Standalone_F_Q_Admin_Q_Resolved</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Q_Appointment" name="Resolve appointment question">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="h-enquiry-response" bindingType="deployment" />
        <zeebe:taskHeaders>
          <zeebe:header key="requiredRole" value="Call Handling Team" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=false" target="enquiryResolved" />
          <zeebe:output source="=enquiryResponse" target="enquiryResponse" />
          <zeebe:output source="=responseStaffId" target="responseStaffId" />
          <zeebe:output source="=enquiryResolved" target="enquiryResolved" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F_Enquiry_Appointment</bpmn:incoming>
      <bpmn:outgoing>Hospital_Enquiry_Standalone_F_Q_Appointment_Q_Resolved</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Q_Finance" name="Answer funding / payment enquiry">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="h-enquiry-response" bindingType="deployment" />
        <zeebe:taskHeaders>
          <zeebe:header key="requiredRole" value="Finance Team" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=false" target="enquiryResolved" />
          <zeebe:output source="=enquiryResponse" target="enquiryResponse" />
          <zeebe:output source="=responseStaffId" target="responseStaffId" />
          <zeebe:output source="=enquiryResolved" target="enquiryResolved" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F_Enquiry_Funding</bpmn:incoming>
      <bpmn:outgoing>Hospital_Enquiry_Standalone_F_Q_Finance_Q_Resolved</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Q_Triage" name="Qualified clinical triage">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="h-enquiry-triage" bindingType="deployment" />
        <zeebe:taskHeaders>
          <zeebe:header key="requiredRole" value="Clinical Nurse Specialist Team" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:output source="=clinicalUrgency" target="clinicalUrgency" />
          <zeebe:output source="=triageNotes" target="triageNotes" />
          <zeebe:output source="=triageClinicianId" target="triageClinicianId" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>F_Enquiry_Clinical</bpmn:incoming>
      <bpmn:outgoing>Hospital_Enquiry_Standalone_F_Q_Triage_Q_Urgent</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Q_Urgent" name="Urgent clinical concern?" default="Q_F_Routine">
      <bpmn:incoming>Hospital_Enquiry_Standalone_F_Q_Triage_Q_Urgent</bpmn:incoming>
      <bpmn:outgoing>Q_F_Urgent</bpmn:outgoing>
      <bpmn:outgoing>Q_F_Routine</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Q_UrgentResponse" name="Immediate qualified clinical response">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="h-enquiry-response" bindingType="deployment" />
        <zeebe:taskHeaders>
          <zeebe:header key="requiredRole" value="Clinical Nurse Specialist Team" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=false" target="enquiryResolved" />
          <zeebe:output source="=enquiryResponse" target="enquiryResponse" />
          <zeebe:output source="=responseStaffId" target="responseStaffId" />
          <zeebe:output source="=enquiryResolved" target="enquiryResolved" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Q_F_Urgent</bpmn:incoming>
      <bpmn:outgoing>Hospital_Enquiry_Standalone_F_Q_UrgentResponse_Q_Resolved</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Q_Clinical" name="Provide authorised clinical response">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="h-enquiry-response" bindingType="deployment" />
        <zeebe:taskHeaders>
          <zeebe:header key="requiredRole" value="Clinical Nurse Specialist Team" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=false" target="enquiryResolved" />
          <zeebe:output source="=enquiryResponse" target="enquiryResponse" />
          <zeebe:output source="=responseStaffId" target="responseStaffId" />
          <zeebe:output source="=enquiryResolved" target="enquiryResolved" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Q_F_Routine</bpmn:incoming>
      <bpmn:outgoing>Hospital_Enquiry_Standalone_F_Q_Clinical_Q_Resolved</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Q_Resolved" name="Enquiry resolved?" default="Q_F_Unresolved">
      <bpmn:incoming>Hospital_Enquiry_Standalone_F_Q_Admin_Q_Resolved</bpmn:incoming>
      <bpmn:incoming>Hospital_Enquiry_Standalone_F_Q_Appointment_Q_Resolved</bpmn:incoming>
      <bpmn:incoming>Hospital_Enquiry_Standalone_F_Q_Finance_Q_Resolved</bpmn:incoming>
      <bpmn:incoming>Hospital_Enquiry_Standalone_F_Q_UrgentResponse_Q_Resolved</bpmn:incoming>
      <bpmn:incoming>Hospital_Enquiry_Standalone_F_Q_Clinical_Q_Resolved</bpmn:incoming>
      <bpmn:outgoing>Q_F_Resolved</bpmn:outgoing>
      <bpmn:outgoing>Q_F_Unresolved</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Q_Notify" name="Record response and notify patient">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="hospital.enquiry.audit.record" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Q_F_Resolved</bpmn:incoming>
      <bpmn:outgoing>Hospital_Enquiry_Standalone_F_Q_Notify_Q_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Q_End" name="Enquiry resolved">
      <bpmn:incoming>Hospital_Enquiry_Standalone_F_Q_Notify_Q_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Hospital_Enquiry_Standalone_F_Q_Start_Q_Init" sourceRef="Q_Start" targetRef="Q_Init" />
    <bpmn:sequenceFlow id="Hospital_Enquiry_Standalone_F_Q_Manual_Q_Init" sourceRef="Q_Manual" targetRef="Q_Init" />
    <bpmn:sequenceFlow id="Hospital_Enquiry_Standalone_F_Q_Init_Q_Record" sourceRef="Q_Init" targetRef="Q_Record" />
    <bpmn:sequenceFlow id="Q_F_Unresolved" name="Reassign / follow up" sourceRef="Q_Resolved" targetRef="Q_Record" />
    <bpmn:sequenceFlow id="Hospital_Enquiry_Standalone_F_Q_Record_Q_Type" sourceRef="Q_Record" targetRef="Q_Type" />
    <bpmn:sequenceFlow id="F_Enquiry_Admin" name="Administrative" sourceRef="Q_Type" targetRef="Q_Admin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=enquiryType = "administrative"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Enquiry_Appointment" name="Appointment" sourceRef="Q_Type" targetRef="Q_Appointment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=enquiryType = "appointment"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Enquiry_Funding" name="Financial" sourceRef="Q_Type" targetRef="Q_Finance">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=enquiryType = "financial"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Enquiry_Clinical" name="Clinical" sourceRef="Q_Type" targetRef="Q_Triage" />
    <bpmn:sequenceFlow id="Hospital_Enquiry_Standalone_F_Q_Admin_Q_Resolved" sourceRef="Q_Admin" targetRef="Q_Resolved" />
    <bpmn:sequenceFlow id="Hospital_Enquiry_Standalone_F_Q_Appointment_Q_Resolved" sourceRef="Q_Appointment" targetRef="Q_Resolved" />
    <bpmn:sequenceFlow id="Hospital_Enquiry_Standalone_F_Q_Finance_Q_Resolved" sourceRef="Q_Finance" targetRef="Q_Resolved" />
    <bpmn:sequenceFlow id="Hospital_Enquiry_Standalone_F_Q_Triage_Q_Urgent" sourceRef="Q_Triage" targetRef="Q_Urgent" />
    <bpmn:sequenceFlow id="Q_F_Urgent" name="Urgent" sourceRef="Q_Urgent" targetRef="Q_UrgentResponse">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=clinicalUrgency = "urgent" or enquiryPriority = "urgent"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Q_F_Routine" name="Routine" sourceRef="Q_Urgent" targetRef="Q_Clinical" />
    <bpmn:sequenceFlow id="Hospital_Enquiry_Standalone_F_Q_UrgentResponse_Q_Resolved" sourceRef="Q_UrgentResponse" targetRef="Q_Resolved" />
    <bpmn:sequenceFlow id="Hospital_Enquiry_Standalone_F_Q_Clinical_Q_Resolved" sourceRef="Q_Clinical" targetRef="Q_Resolved" />
    <bpmn:sequenceFlow id="Q_F_Resolved" name="Yes" sourceRef="Q_Resolved" targetRef="Q_Notify">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=enquiryResolved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Hospital_Enquiry_Standalone_F_Q_Notify_Q_End" sourceRef="Q_Notify" targetRef="Q_End" />
  </bpmn:process>
  <bpmn:message id="Q_Start_Message" name="Patient enquiry received (standalone)" />
  <bpmndi:BPMNDiagram id="Diagram_Hospital_Enquiry_Standalone">
    <bpmndi:BPMNPlane id="Plane_Hospital_Enquiry_Standalone" bpmnElement="Collaboration_Hospital_Enquiry_Standalone">
      <bpmndi:BPMNShape id="Participant_ExternalEnquiry_di" bpmnElement="Participant_ExternalEnquiry" isHorizontal="true">
        <dc:Bounds x="430" y="80" width="500" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pool_Hospital_Enquiry_Standalone_di" bpmnElement="Pool_Hospital_Enquiry_Standalone" isHorizontal="true">
        <dc:Bounds x="160" y="280" width="2370" height="1260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Hospital_Enquiry_Standalone_Lane_0_di" bpmnElement="Hospital_Enquiry_Standalone_Lane_0" isHorizontal="true">
        <dc:Bounds x="190" y="280" width="2340" height="390" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Hospital_Enquiry_Standalone_Lane_1_di" bpmnElement="Hospital_Enquiry_Standalone_Lane_1" isHorizontal="true">
        <dc:Bounds x="190" y="670" width="2340" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Hospital_Enquiry_Standalone_Lane_2_di" bpmnElement="Hospital_Enquiry_Standalone_Lane_2" isHorizontal="true">
        <dc:Bounds x="190" y="910" width="2340" height="390" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Hospital_Enquiry_Standalone_Lane_3_di" bpmnElement="Hospital_Enquiry_Standalone_Lane_3" isHorizontal="true">
        <dc:Bounds x="190" y="1300" width="2340" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Q_Start_di" bpmnElement="Q_Start">
        <dc:Bounds x="337" y="372" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="296" y="416" width="119" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Q_Manual_di" bpmnElement="Q_Manual">
        <dc:Bounds x="337" y="532" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="291" y="576" width="128" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Q_Init_di" bpmnElement="Q_Init">
        <dc:Bounds x="500" y="1365" width="150" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Q_Record_di" bpmnElement="Q_Record">
        <dc:Bounds x="720" y="345" width="150" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Q_Type_di" bpmnElement="Q_Type" isMarkerVisible="true">
        <dc:Bounds x="990" y="365" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="981" y="341" width="68" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Q_Admin_di" bpmnElement="Q_Admin">
        <dc:Bounds x="1160" y="345" width="150" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Q_Appointment_di" bpmnElement="Q_Appointment">
        <dc:Bounds x="1160" y="505" width="150" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Q_Finance_di" bpmnElement="Q_Finance">
        <dc:Bounds x="1160" y="735" width="150" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Q_Triage_di" bpmnElement="Q_Triage">
        <dc:Bounds x="1160" y="975" width="150" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Q_Urgent_di" bpmnElement="Q_Urgent" isMarkerVisible="true">
        <dc:Bounds x="1430" y="995" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1396" y="983" width="118" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Q_UrgentResponse_di" bpmnElement="Q_UrgentResponse">
        <dc:Bounds x="1600" y="1135" width="150" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Q_Clinical_di" bpmnElement="Q_Clinical">
        <dc:Bounds x="1600" y="975" width="150" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Q_Resolved_di" bpmnElement="Q_Resolved" isMarkerVisible="true">
        <dc:Bounds x="1870" y="365" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1850" y="341" width="89" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Q_Notify_di" bpmnElement="Q_Notify">
        <dc:Bounds x="2040" y="1365" width="150" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Q_End_di" bpmnElement="Q_End">
        <dc:Bounds x="2317" y="1392" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2294" y="1436" width="82" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Hospital_Enquiry_Standalone_F_Q_Start_Q_Init_di" bpmnElement="Hospital_Enquiry_Standalone_F_Q_Start_Q_Init">
        <di:waypoint x="373" y="390" />
        <di:waypoint x="411" y="390" />
        <di:waypoint x="411" y="1410" />
        <di:waypoint x="500" y="1410" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Hospital_Enquiry_Standalone_F_Q_Manual_Q_Init_di" bpmnElement="Hospital_Enquiry_Standalone_F_Q_Manual_Q_Init">
        <di:waypoint x="373" y="550" />
        <di:waypoint x="411" y="550" />
        <di:waypoint x="411" y="1410" />
