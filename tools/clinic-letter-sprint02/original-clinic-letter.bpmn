<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Letter" targetNamespace="https://github.com/LongrenLison/BPM-EA-and-AISD">
  <bpmn:collaboration id="Collaboration_Letter"><bpmn:participant id="Participant_LetterHospital" name="Hospital Patient Administration System" processRef="Process_Letter" /><bpmn:participant id="Participant_LetterCorrespondence" name="External Correspondence Service" /></bpmn:collaboration>
  <bpmn:process id="Process_Letter" name="Clinic Letter Delay and Escalation" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Letter"><bpmn:lane id="Lane_LetterConsultant" name="Consultant"><bpmn:flowNodeRef>Start_Appointment</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_DraftLetter</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Approved</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ReviewClinicalError</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_LetterSecretary" name="Medical Secretaries"><bpmn:flowNodeRef>Task_AdminCheck</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_DistributeLetter</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Sent</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Pathway" name="Patient Pathway Coordinator"><bpmn:flowNodeRef>Timer_SevenDays</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Completed</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_WeeklyReminder</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_OneMonth</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_AdminManager" name="Administrative Manager and Higher Management"><bpmn:flowNodeRef>Task_EscalateOneMonth</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_ThreeMonths</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_EscalateThreeMonths</bpmn:flowNodeRef><bpmn:flowNodeRef>End_ClosedAfterEscalation</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
    <bpmn:startEvent id="Start_Appointment" name="Consultation or treatment review completed" /><bpmn:task id="Task_DraftLetter" name="Draft and clinically approve Clinic Letter" /><bpmn:exclusiveGateway id="Gateway_Approved" name="Clinically approved?" default="Flow_NotApproved" /><bpmn:task id="Task_ReviewClinicalError" name="Consultant corrects clinical content" /><bpmn:task id="Task_AdminCheck" name="Secretary checks recipients and administrative details" /><bpmn:serviceTask id="Task_DistributeLetter" name="Distribute approved letter through correspondence service" /><bpmn:endEvent id="End_Sent" name="Letter sent and dates recorded" /><bpmn:intermediateCatchEvent id="Timer_SevenDays" name="Seven days after appointment"><bpmn:timerEventDefinition /></bpmn:intermediateCatchEvent><bpmn:exclusiveGateway id="Gateway_Completed" name="Letter completed and approved?" default="Flow_Delayed" /><bpmn:task id="Task_WeeklyReminder" name="Record delay; issue weekly reminder" /><bpmn:exclusiveGateway id="Gateway_OneMonth" name="Outstanding more than one month?" default="Flow_ReminderLoop" /><bpmn:task id="Task_EscalateOneMonth" name="Administrative Manager contacts responsible Consultant" /><bpmn:exclusiveGateway id="Gateway_ThreeMonths" name="Outstanding more than three months?" default="Flow_StillOpen" /><bpmn:task id="Task_EscalateThreeMonths" name="Escalate to higher management" /><bpmn:endEvent id="End_ClosedAfterEscalation" name="Escalation history retained" />
    <bpmn:sequenceFlow id="Flow_LetterStartDraft" sourceRef="Start_Appointment" targetRef="Task_DraftLetter" /><bpmn:sequenceFlow id="Flow_DraftApproved" sourceRef="Task_DraftLetter" targetRef="Gateway_Approved" /><bpmn:sequenceFlow id="Flow_NotApproved" name="No" sourceRef="Gateway_Approved" targetRef="Task_ReviewClinicalError" /><bpmn:sequenceFlow id="Flow_CorrectRedraft" sourceRef="Task_ReviewClinicalError" targetRef="Task_DraftLetter" /><bpmn:sequenceFlow id="Flow_ApprovedAdmin" name="Yes" sourceRef="Gateway_Approved" targetRef="Task_AdminCheck" /><bpmn:sequenceFlow id="Flow_AdminSend" sourceRef="Task_AdminCheck" targetRef="Task_DistributeLetter" /><bpmn:sequenceFlow id="Flow_SendEnd" sourceRef="Task_DistributeLetter" targetRef="End_Sent" /><bpmn:sequenceFlow id="Flow_DraftTimer" sourceRef="Task_DraftLetter" targetRef="Timer_SevenDays" /><bpmn:sequenceFlow id="Flow_TimerCompleted" sourceRef="Timer_SevenDays" targetRef="Gateway_Completed" /><bpmn:sequenceFlow id="Flow_Delayed" name="No" sourceRef="Gateway_Completed" targetRef="Task_WeeklyReminder" /><bpmn:sequenceFlow id="Flow_CompletedEnd" name="Yes; suppress reminder" sourceRef="Gateway_Completed" targetRef="End_Sent" /><bpmn:sequenceFlow id="Flow_ReminderMonth" sourceRef="Task_WeeklyReminder" targetRef="Gateway_OneMonth" /><bpmn:sequenceFlow id="Flow_ReminderLoop" name="No; still delayed" sourceRef="Gateway_OneMonth" targetRef="Task_WeeklyReminder" /><bpmn:sequenceFlow id="Flow_EscalateOneMonth" name="Yes" sourceRef="Gateway_OneMonth" targetRef="Task_EscalateOneMonth" /><bpmn:sequenceFlow id="Flow_OneMonthThreeMonths" sourceRef="Task_EscalateOneMonth" targetRef="Gateway_ThreeMonths" /><bpmn:sequenceFlow id="Flow_StillOpen" name="No; monitor" sourceRef="Gateway_ThreeMonths" targetRef="Task_WeeklyReminder" /><bpmn:sequenceFlow id="Flow_EscalateThreeMonths" name="Yes" sourceRef="Gateway_ThreeMonths" targetRef="Task_EscalateThreeMonths" /><bpmn:sequenceFlow id="Flow_EscalationEnd" sourceRef="Task_EscalateThreeMonths" targetRef="End_ClosedAfterEscalation" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Letter">
    <bpmndi:BPMNPlane id="Plane_Letter" bpmnElement="Collaboration_Letter">
      <bpmndi:BPMNShape id="Shape_Participant_LetterHospital" bpmnElement="Participant_LetterHospital" isHorizontal="true"><dc:Bounds x="30" y="60" width="2250" height="780" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Participant_LetterCorrespondence" bpmnElement="Participant_LetterCorrespondence" isHorizontal="true" isExpanded="false"><dc:Bounds x="1130" y="895" width="850" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_LetterConsultant" bpmnElement="Lane_LetterConsultant" isHorizontal="true"><dc:Bounds x="60" y="60" width="2190" height="190" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_LetterSecretary" bpmnElement="Lane_LetterSecretary" isHorizontal="true"><dc:Bounds x="60" y="250" width="2190" height="150" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Pathway" bpmnElement="Lane_Pathway" isHorizontal="true"><dc:Bounds x="60" y="400" width="2190" height="170" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_AdminManager" bpmnElement="Lane_AdminManager" isHorizontal="true"><dc:Bounds x="60" y="570" width="2190" height="220" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_Appointment" bpmnElement="Start_Appointment"><dc:Bounds x="150" y="133" width="44" height="44" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_DraftLetter" bpmnElement="Task_DraftLetter"><dc:Bounds x="250" y="121" width="170" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Approved" bpmnElement="Gateway_Approved"><dc:Bounds x="470" y="133" width="44" height="44" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ReviewClinicalError" bpmnElement="Task_ReviewClinicalError"><dc:Bounds x="610" y="121" width="170" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_AdminCheck" bpmnElement="Task_AdminCheck"><dc:Bounds x="650" y="291" width="170" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_DistributeLetter" bpmnElement="Task_DistributeLetter"><dc:Bounds x="870" y="291" width="170" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Sent" bpmnElement="End_Sent"><dc:Bounds x="1090" y="303" width="44" height="44" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Timer_SevenDays" bpmnElement="Timer_SevenDays"><dc:Bounds x="520" y="463" width="44" height="44" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Completed" bpmnElement="Gateway_Completed"><dc:Bounds x="680" y="463" width="44" height="44" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_WeeklyReminder" bpmnElement="Task_WeeklyReminder"><dc:Bounds x="830" y="451" width="170" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_OneMonth" bpmnElement="Gateway_OneMonth"><dc:Bounds x="1050" y="463" width="44" height="44" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_EscalateOneMonth" bpmnElement="Task_EscalateOneMonth"><dc:Bounds x="1220" y="626" width="170" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_ThreeMonths" bpmnElement="Gateway_ThreeMonths"><dc:Bounds x="1450" y="638" width="44" height="44" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_EscalateThreeMonths" bpmnElement="Task_EscalateThreeMonths"><dc:Bounds x="1600" y="626" width="170" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_ClosedAfterEscalation" bpmnElement="End_ClosedAfterEscalation"><dc:Bounds x="1820" y="638" width="44" height="44" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_LetterStartDraft" bpmnElement="Flow_LetterStartDraft"><di:waypoint x="194" y="155" /><di:waypoint x="214" y="155" /><di:waypoint x="250" y="155" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_DraftApproved" bpmnElement="Flow_DraftApproved"><di:waypoint x="420" y="155" /><di:waypoint x="434" y="155" /><di:waypoint x="470" y="155" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_NotApproved" bpmnElement="Flow_NotApproved"><di:waypoint x="514" y="155" /><di:waypoint x="574" y="155" /><di:waypoint x="610" y="155" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_CorrectRedraft" bpmnElement="Flow_CorrectRedraft"><di:waypoint x="695" y="121" /><di:waypoint x="695" y="85" /><di:waypoint x="335" y="85" /><di:waypoint x="335" y="121" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_ApprovedAdmin" bpmnElement="Flow_ApprovedAdmin"><di:waypoint x="492" y="177" /><di:waypoint x="540" y="177" /><di:waypoint x="540" y="325" /><di:waypoint x="650" y="325" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_AdminSend" bpmnElement="Flow_AdminSend"><di:waypoint x="820" y="325" /><di:waypoint x="834" y="325" /><di:waypoint x="870" y="325" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_SendEnd" bpmnElement="Flow_SendEnd"><di:waypoint x="1040" y="325" /><di:waypoint x="1054" y="325" /><di:waypoint x="1090" y="325" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_DraftTimer" bpmnElement="Flow_DraftTimer"><di:waypoint x="335" y="189" /><di:waypoint x="335" y="420" /><di:waypoint x="480" y="420" /><di:waypoint x="520" y="485" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_TimerCompleted" bpmnElement="Flow_TimerCompleted"><di:waypoint x="564" y="485" /><di:waypoint x="644" y="485" /><di:waypoint x="680" y="485" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Delayed" bpmnElement="Flow_Delayed"><di:waypoint x="724" y="485" /><di:waypoint x="794" y="485" /><di:waypoint x="830" y="485" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_CompletedEnd" bpmnElement="Flow_CompletedEnd"><di:waypoint x="702" y="463" /><di:waypoint x="702" y="425" /><di:waypoint x="1112" y="425" /><di:waypoint x="1112" y="347" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_ReminderMonth" bpmnElement="Flow_ReminderMonth"><di:waypoint x="1000" y="485" /><di:waypoint x="1014" y="485" /><di:waypoint x="1050" y="485" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_ReminderLoop" bpmnElement="Flow_ReminderLoop"><di:waypoint x="1072" y="507" /><di:waypoint x="1072" y="555" /><di:waypoint x="915" y="555" /><di:waypoint x="915" y="519" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_EscalateOneMonth" bpmnElement="Flow_EscalateOneMonth"><di:waypoint x="1094" y="485" /><di:waypoint x="1184" y="485" /><di:waypoint x="1184" y="660" /><di:waypoint x="1220" y="660" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_OneMonthThreeMonths" bpmnElement="Flow_OneMonthThreeMonths"><di:waypoint x="1390" y="660" /><di:waypoint x="1414" y="660" /><di:waypoint x="1450" y="660" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_StillOpen" bpmnElement="Flow_StillOpen"><di:waypoint x="1472" y="682" /><di:waypoint x="1472" y="835" /><di:waypoint x="915" y="835" /><di:waypoint x="915" y="519" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_EscalateThreeMonths" bpmnElement="Flow_EscalateThreeMonths"><di:waypoint x="1494" y="660" /><di:waypoint x="1564" y="660" /><di:waypoint x="1600" y="660" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_EscalationEnd" bpmnElement="Flow_EscalationEnd"><di:waypoint x="1770" y="660" /><di:waypoint x="1784" y="660" /><di:waypoint x="1820" y="660" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
