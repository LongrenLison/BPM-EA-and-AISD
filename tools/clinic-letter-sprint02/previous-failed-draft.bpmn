<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ClinicLetterSprint02" targetNamespace="https://github.com/LongrenLison/BPM-EA-and-AISD/clinic-letter-sprint02">
  <bpmn:error id="Error_DispatchRejected" name="Dispatch rejected" errorCode="CLINIC_LETTER_DISPATCH_REJECTED" />
  <bpmn:process id="Process_ClinicLetterSprint02" name="Clinic Letter Sprint 02" isExecutable="true">
    <bpmn:documentation>Start at consultation completion with consultationCompletedAt as an ISO date-time. Production durations are P7D, P1M and P3M. Successful dispatch terminates the instance and cancels monitoring.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_ClinicLetter">
      <bpmn:lane id="Lane_Consultant" name="Consultant"><bpmn:flowNodeRef>Start_ConsultationCompleted</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_StartParallel</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_DraftLetter</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ConsultantApproval</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Approved</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Secretary" name="Medical Secretary"><bpmn:flowNodeRef>Task_AdminCheck</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Dispatch</bpmn:flowNodeRef><bpmn:flowNodeRef>Boundary_DispatchError</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ResolveDispatchFailure</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Sent</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Pathway" name="Patient Pathway Coordinator"><bpmn:flowNodeRef>Timer_SevenDays</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ReminderBeforeMonth</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_OneMonth</bpmn:flowNodeRef><bpmn:flowNodeRef>Timer_WeekBeforeMonth</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ReminderBeforeThreeMonths</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_ThreeMonths</bpmn:flowNodeRef><bpmn:flowNodeRef>Timer_WeekBeforeThreeMonths</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ReminderAfterThreeMonths</bpmn:flowNodeRef><bpmn:flowNodeRef>Timer_WeekAfterThreeMonths</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Management" name="Administrative Manager / Higher Management"><bpmn:flowNodeRef>Task_EscalateOneMonth</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_EscalateThreeMonths</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_ConsultationCompleted" name="Consultation or review completed" />
    <bpmn:parallelGateway id="Gateway_StartParallel" name="Start work and monitoring" />
    <bpmn:userTask id="Task_DraftLetter" name="Consultant drafts Clinic Letter"><bpmn:extensionElements><zeebe:formDefinition formId="clinic-letter-draft-sprint02" bindingType="latest" /><zeebe:assignmentDefinition candidateGroups="consultants" /></bpmn:extensionElements></bpmn:userTask>
    <bpmn:userTask id="Task_ConsultantApproval" name="Consultant clinically approves letter"><bpmn:extensionElements><zeebe:formDefinition formId="clinic-letter-clinical-approval-sprint02" bindingType="latest" /><zeebe:assignmentDefinition candidateGroups="consultants" /></bpmn:extensionElements></bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Approved" name="Clinically approved?" default="Flow_Rejected" />
    <bpmn:userTask id="Task_AdminCheck" name="Secretary checks recipients and administrative details"><bpmn:extensionElements><zeebe:formDefinition formId="clinic-letter-admin-check-sprint02" bindingType="latest" /><zeebe:assignmentDefinition candidateGroups="medical-secretaries" /></bpmn:extensionElements></bpmn:userTask>
    <bpmn:serviceTask id="Task_Dispatch" name="Dispatch approved letter"><bpmn:extensionElements><zeebe:taskDefinition type="clinic-letter.sprint02.dispatch" retries="3" /><zeebe:taskHeaders><zeebe:header key="integrationMapping" value="correspondence.dispatch" /><zeebe:header key="demoSafety" value="no-real-email" /></zeebe:taskHeaders></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_DispatchError" name="Dispatch rejected" attachedToRef="Task_Dispatch"><bpmn:errorEventDefinition errorRef="Error_DispatchRejected" /></bpmn:boundaryEvent>
    <bpmn:userTask id="Task_ResolveDispatchFailure" name="Secretary resolves dispatch failure"><bpmn:extensionElements><zeebe:formDefinition formId="clinic-letter-dispatch-retry-sprint02" bindingType="latest" /><zeebe:assignmentDefinition candidateGroups="medical-secretaries" /></bpmn:extensionElements></bpmn:userTask>
    <bpmn:endEvent id="End_Sent" name="Sent; cancel monitoring"><bpmn:terminateEventDefinition /></bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Timer_SevenDays" name="Wait seven days"><bpmn:timerEventDefinition><bpmn:timeDuration>P7D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_ReminderBeforeMonth" name="Record delay and issue weekly reminder"><bpmn:extensionElements><zeebe:taskDefinition type="clinic-letter.sprint02.reminder" retries="3" /></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_OneMonth" name="One calendar month reached?" default="Flow_NotOneMonth" />
    <bpmn:intermediateCatchEvent id="Timer_WeekBeforeMonth" name="Wait one week"><bpmn:timerEventDefinition><bpmn:timeDuration>P7D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_EscalateOneMonth" name="Manager contacts responsible Consultant"><bpmn:extensionElements><zeebe:taskDefinition type="clinic-letter.sprint02.escalate-one-month" retries="3" /></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ReminderBeforeThreeMonths" name="Continue weekly reminder"><bpmn:extensionElements><zeebe:taskDefinition type="clinic-letter.sprint02.reminder" retries="3" /></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_ThreeMonths" name="Three calendar months reached?" default="Flow_NotThreeMonths" />
    <bpmn:intermediateCatchEvent id="Timer_WeekBeforeThreeMonths" name="Wait one week"><bpmn:timerEventDefinition><bpmn:timeDuration>P7D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_EscalateThreeMonths" name="Escalate to higher management"><bpmn:extensionElements><zeebe:taskDefinition type="clinic-letter.sprint02.escalate-three-months" retries="3" /></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ReminderAfterThreeMonths" name="Retain case and continue weekly reminder"><bpmn:extensionElements><zeebe:taskDefinition type="clinic-letter.sprint02.reminder" retries="3" /></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Timer_WeekAfterThreeMonths" name="Wait one week"><bpmn:timerEventDefinition><bpmn:timeDuration>P7D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_StartSplit" sourceRef="Start_ConsultationCompleted" targetRef="Gateway_StartParallel" />
    <bpmn:sequenceFlow id="Flow_StartDraft" sourceRef="Gateway_StartParallel" targetRef="Task_DraftLetter" />
    <bpmn:sequenceFlow id="Flow_DraftApproval" sourceRef="Task_DraftLetter" targetRef="Task_ConsultantApproval" />
    <bpmn:sequenceFlow id="Flow_CheckApproval" sourceRef="Task_ConsultantApproval" targetRef="Gateway_Approved" />
    <bpmn:sequenceFlow id="Flow_Approved" name="Approved" sourceRef="Gateway_Approved" targetRef="Task_AdminCheck"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= clinicalApproved = true</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Rejected" name="Reject and rework" sourceRef="Gateway_Approved" targetRef="Task_DraftLetter" />
    <bpmn:sequenceFlow id="Flow_AdminDispatch" sourceRef="Task_AdminCheck" targetRef="Task_Dispatch" /><bpmn:sequenceFlow id="Flow_DispatchSent" sourceRef="Task_Dispatch" targetRef="End_Sent" /><bpmn:sequenceFlow id="Flow_DispatchError" sourceRef="Boundary_DispatchError" targetRef="Task_ResolveDispatchFailure" /><bpmn:sequenceFlow id="Flow_RetryDispatch" sourceRef="Task_ResolveDispatchFailure" targetRef="Task_Dispatch" />
    <bpmn:sequenceFlow id="Flow_StartMonitoring" sourceRef="Gateway_StartParallel" targetRef="Timer_SevenDays" /><bpmn:sequenceFlow id="Flow_FirstReminder" sourceRef="Timer_SevenDays" targetRef="Task_ReminderBeforeMonth" /><bpmn:sequenceFlow id="Flow_CheckOneMonth" sourceRef="Task_ReminderBeforeMonth" targetRef="Gateway_OneMonth" />
    <bpmn:sequenceFlow id="Flow_OneMonth" name="Reached" sourceRef="Gateway_OneMonth" targetRef="Task_EscalateOneMonth"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= now() &gt;= date and time(consultationCompletedAt) + duration("P1M")</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotOneMonth" name="Not yet" sourceRef="Gateway_OneMonth" targetRef="Timer_WeekBeforeMonth" /><bpmn:sequenceFlow id="Flow_LoopBeforeMonth" sourceRef="Timer_WeekBeforeMonth" targetRef="Task_ReminderBeforeMonth" /><bpmn:sequenceFlow id="Flow_AfterOneMonth" sourceRef="Task_EscalateOneMonth" targetRef="Task_ReminderBeforeThreeMonths" /><bpmn:sequenceFlow id="Flow_CheckThreeMonths" sourceRef="Task_ReminderBeforeThreeMonths" targetRef="Gateway_ThreeMonths" />
    <bpmn:sequenceFlow id="Flow_ThreeMonths" name="Reached" sourceRef="Gateway_ThreeMonths" targetRef="Task_EscalateThreeMonths"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= now() &gt;= date and time(consultationCompletedAt) + duration("P3M")</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotThreeMonths" name="Not yet" sourceRef="Gateway_ThreeMonths" targetRef="Timer_WeekBeforeThreeMonths" /><bpmn:sequenceFlow id="Flow_LoopBeforeThreeMonths" sourceRef="Timer_WeekBeforeThreeMonths" targetRef="Task_ReminderBeforeThreeMonths" /><bpmn:sequenceFlow id="Flow_AfterThreeMonths" sourceRef="Task_EscalateThreeMonths" targetRef="Task_ReminderAfterThreeMonths" /><bpmn:sequenceFlow id="Flow_WaitAfterThreeMonths" sourceRef="Task_ReminderAfterThreeMonths" targetRef="Timer_WeekAfterThreeMonths" /><bpmn:sequenceFlow id="Flow_LoopAfterThreeMonths" sourceRef="Timer_WeekAfterThreeMonths" targetRef="Task_ReminderAfterThreeMonths" />
  </bpmn:process>
</bpmn:definitions>
