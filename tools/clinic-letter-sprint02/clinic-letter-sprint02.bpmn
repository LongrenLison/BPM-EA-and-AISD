    <bpmndi:BPMNShape id="Shape_RecordDraftStart" bpmnElement="RecordDraftStart"><dc:Bounds x="340" y="110" width="120" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Draft" bpmnElement="Draft"><dc:Bounds x="500" y="110" width="180" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Approve" bpmnElement="Approve"><dc:Bounds x="720" y="110" width="180" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Approved" bpmnElement="Approved" isMarkerVisible="true"><dc:Bounds x="930" y="110" width="50" height="50" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Admin" bpmnElement="Admin"><dc:Bounds x="970" y="310" width="180" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_AdminReady" bpmnElement="AdminReady" isMarkerVisible="true"><dc:Bounds x="1170" y="310" width="50" height="50" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Dispatch" bpmnElement="Dispatch"><dc:Bounds x="1330" y="310" width="180" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Retry" bpmnElement="Retry"><dc:Bounds x="1330" y="450" width="180" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_RetryReady" bpmnElement="RetryReady" isMarkerVisible="true"><dc:Bounds x="1550" y="450" width="50" height="50" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Sent" bpmnElement="Sent"><dc:Bounds x="1770" y="310" width="38" height="38" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_SevenDays" bpmnElement="SevenDays"><dc:Bounds x="400" y="650" width="38" height="38" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Reminder" bpmnElement="Reminder"><dc:Bounds x="640" y="650" width="180" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Week" bpmnElement="Week"><dc:Bounds x="900" y="650" width="38" height="38" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_OneMonth" bpmnElement="OneMonth"><dc:Bounds x="400" y="850" width="38" height="38" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_EscalateMonth" bpmnElement="EscalateMonth"><dc:Bounds x="690" y="850" width="180" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_MonthDone" bpmnElement="MonthDone"><dc:Bounds x="1010" y="850" width="38" height="38" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_ThreeMonths" bpmnElement="ThreeMonths"><dc:Bounds x="400" y="1050" width="38" height="38" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_EscalateThree" bpmnElement="EscalateThree"><dc:Bounds x="690" y="1050" width="180" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_ThreeDone" bpmnElement="ThreeDone"><dc:Bounds x="1010" y="1050" width="38" height="38" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_DispatchError" bpmnElement="DispatchError"><dc:Bounds x="1400" y="371" width="38" height="38" /></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="Edge_StartSplit" bpmnElement="Flow_StartSplit"><di:waypoint x="158" y="129" /><di:waypoint x="240" y="135" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_StartDraft" bpmnElement="Flow_StartDraft"><di:waypoint x="290" y="135" /><di:waypoint x="340" y="150" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_RecordDraft" bpmnElement="Flow_RecordDraft"><di:waypoint x="460" y="150" /><di:waypoint x="500" y="150" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_DraftApproval" bpmnElement="Flow_DraftApproval"><di:waypoint x="680" y="150" /><di:waypoint x="720" y="150" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_ApprovalDecision" bpmnElement="Flow_ApprovalDecision"><di:waypoint x="900" y="150" /><di:waypoint x="930" y="135" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_Approved" bpmnElement="Flow_Approved"><di:waypoint x="955" y="160" /><di:waypoint x="955" y="350" /><di:waypoint x="970" y="350" /><bpmndi:BPMNLabel><dc:Bounds x="965" y="170" width="130" height="20" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_Rejected" bpmnElement="Flow_Rejected"><di:waypoint x="955" y="110" /><di:waypoint x="955" y="60" /><di:waypoint x="400" y="60" /><di:waypoint x="400" y="110" /><bpmndi:BPMNLabel><dc:Bounds x="620" y="38" width="130" height="20" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_ClinicalCorrection" bpmnElement="Flow_ClinicalCorrection"><di:waypoint x="1220" y="335" /><di:waypoint x="1275" y="335" /><di:waypoint x="1275" y="215" /><di:waypoint x="400" y="215" /><di:waypoint x="400" y="190" /><bpmndi:BPMNLabel><dc:Bounds x="1080" y="193" width="170" height="20" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_AdminDecision" bpmnElement="Flow_AdminDecision"><di:waypoint x="1150" y="350" /><di:waypoint x="1170" y="335" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_AdminOK" bpmnElement="Flow_AdminOK"><di:waypoint x="1220" y="335" /><di:waypoint x="1330" y="350" /><bpmndi:BPMNLabel><dc:Bounds x="1225" y="312" width="130" height="20" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_AdminIncomplete" bpmnElement="Flow_AdminIncomplete"><di:waypoint x="1195" y="310" /><di:waypoint x="1195" y="270" /><di:waypoint x="1060" y="270" /><di:waypoint x="1060" y="310" /><bpmndi:BPMNLabel><dc:Bounds x="1200" y="287" width="130" height="20" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
