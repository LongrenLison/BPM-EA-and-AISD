<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ClinicLetter" targetNamespace="https://github.com/LongrenLison/BPM-EA-and-AISD/clinic-letter-sprint02">
  <bpmn:error id="Error_DispatchRejected" name="Dispatch rejected / unsafe request" errorCode="CLINIC_LETTER_DISPATCH_REJECTED" />
  <bpmn:process id="Process_ClinicLetterSprint02" name="Clinic Letter Sprint 02" isExecutable="true">
    <bpmn:documentation>Require consultationCompletedAt (ISO date-time with timezone) at start. Seven-day and calendar-month deadlines measured from consultation, not drafting. Weekly reminders are independent of month milestones. Sending is simulated; terminate end cancels process-local monitoring only. Candidate groups require actual Tasklist identity/permissions configuration; labels alone do not enforce access.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_ClinicLetter">
      <bpmn:lane id="Lane_Consultant" name="Consultant"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>Split</bpmn:flowNodeRef><bpmn:flowNodeRef>RecordDraftStart</bpmn:flowNodeRef><bpmn:flowNodeRef>Draft</bpmn:flowNodeRef><bpmn:flowNodeRef>Approve</bpmn:flowNodeRef><bpmn:flowNodeRef>Approved</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Secretary" name="Medical Secretary"><bpmn:flowNodeRef>Admin</bpmn:flowNodeRef><bpmn:flowNodeRef>AdminReady</bpmn:flowNodeRef><bpmn:flowNodeRef>Dispatch</bpmn:flowNodeRef><bpmn:flowNodeRef>Retry</bpmn:flowNodeRef><bpmn:flowNodeRef>RetryReady</bpmn:flowNodeRef><bpmn:flowNodeRef>Sent</bpmn:flowNodeRef><bpmn:flowNodeRef>DispatchError</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Pathway" name="Pathway Coordinator"><bpmn:flowNodeRef>SevenDays</bpmn:flowNodeRef><bpmn:flowNodeRef>Reminder</bpmn:flowNodeRef><bpmn:flowNodeRef>Week</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Management" name="Management notifications"><bpmn:flowNodeRef>OneMonth</bpmn:flowNodeRef><bpmn:flowNodeRef>EscalateMonth</bpmn:flowNodeRef><bpmn:flowNodeRef>MonthDone</bpmn:flowNodeRef><bpmn:flowNodeRef>ThreeMonths</bpmn:flowNodeRef><bpmn:flowNodeRef>EscalateThree</bpmn:flowNodeRef><bpmn:flowNodeRef>ThreeDone</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Consultation / review completed"><bpmn:outgoing>Flow_StartSplit</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="Split" name="Start work and monitoring"><bpmn:incoming>Flow_StartSplit</bpmn:incoming><bpmn:outgoing>Flow_StartDraft</bpmn:outgoing><bpmn:outgoing>Flow_StartMonitoring</bpmn:outgoing><bpmn:outgoing>Flow_StartMonth</bpmn:outgoing><bpmn:outgoing>Flow_StartThree</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:serviceTask id="RecordDraftStart" name="Record draft stage start"><bpmn:extensionElements><zeebe:taskDefinition type="clinic-letter.sprint02.record-draft-start" retries="3" /><zeebe:taskHeaders><zeebe:header key="demoSafety" value="simulated-no-email" /></zeebe:taskHeaders></bpmn:extensionElements><bpmn:incoming>Flow_StartDraft</bpmn:incoming><bpmn:incoming>Flow_Rejected</bpmn:incoming><bpmn:incoming>Flow_ClinicalCorrection</bpmn:incoming><bpmn:outgoing>Flow_RecordDraft</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="Draft" name="Consultant drafts Clinic Letter"><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="clinic-letter-draft-sprint02" bindingType="deployment" /><zeebe:assignmentDefinition candidateGroups="consultants" /><zeebe:ioMapping><zeebe:output source="= clinicLetterId" target="clinicLetterId" /><zeebe:output source="= letterType" target="letterType" /><zeebe:output source="= clinicalSummary" target="clinicalSummary" /><zeebe:output source="= diagnosis" target="diagnosis" /><zeebe:output source="= clinicalFindings" target="clinicalFindings" /><zeebe:output source="= treatmentDecisions" target="treatmentDecisions" /><zeebe:output source="= followUpPlan" target="followUpPlan" /><zeebe:output source="= communicationInstructions" target="communicationInstructions" /><zeebe:output source="= intendedRecipients" target="intendedRecipients" /><zeebe:output source="= delayReason" target="delayReason" /><zeebe:output source="= false" target="clinicalApproved" /><zeebe:output source="= string(now())" target="draftCompletedAt" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_RecordDraft</bpmn:incoming><bpmn:outgoing>Flow_DraftApproval</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="Approve" name="Consultant clinically approves"><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="clinic-letter-clinical-approval-sprint02" bindingType="deployment" /><zeebe:assignmentDefinition candidateGroups="consultants" /><zeebe:ioMapping><zeebe:output source="= clinicalApproved" target="clinicalApproved" /><zeebe:output source="= rejectionReason" target="rejectionReason" /><zeebe:output source="= delayReason" target="delayReason" /><zeebe:output source="= if clinicalApproved = true then string(now()) else null" target="approvedAt" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_DraftApproval</bpmn:incoming><bpmn:outgoing>Flow_ApprovalDecision</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="Approved" name="Clinically approved?" default="Flow_Rejected"><bpmn:incoming>Flow_ApprovalDecision</bpmn:incoming><bpmn:outgoing>Flow_Approved</bpmn:outgoing><bpmn:outgoing>Flow_Rejected</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="Admin" name="Secretary checks recipients / admin details"><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="clinic-letter-admin-check-sprint02" bindingType="deployment" /><zeebe:assignmentDefinition candidateGroups="medical-secretaries" /><zeebe:ioMapping><zeebe:output source="= recipientChecked" target="recipientChecked" /><zeebe:output source="= administrativeDetailsChecked" target="administrativeDetailsChecked" /><zeebe:output source="= if clinicalCorrectionRequested = true then true else false" target="clinicalCorrectionRequested" /><zeebe:output source="= clinicalCorrectionReason" target="clinicalCorrectionReason" /><zeebe:output source="= delayReason" target="delayReason" /><zeebe:output source="= if recipientChecked = true and administrativeDetailsChecked = true and clinicalCorrectionRequested != true then string(now()) else null" target="administrativeProcessedAt" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_Approved</bpmn:incoming><bpmn:incoming>Flow_AdminIncomplete</bpmn:incoming><bpmn:outgoing>Flow_AdminDecision</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="AdminReady" name="Clinical correction or admin ready?" default="Flow_AdminIncomplete"><bpmn:incoming>Flow_AdminDecision</bpmn:incoming><bpmn:outgoing>Flow_ClinicalCorrection</bpmn:outgoing><bpmn:outgoing>Flow_AdminOK</bpmn:outgoing><bpmn:outgoing>Flow_AdminIncomplete</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Dispatch" name="Dispatch approved letter (demo)"><bpmn:extensionElements><zeebe:taskDefinition type="clinic-letter.sprint02.dispatch" retries="3" /><zeebe:taskHeaders><zeebe:header key="demoSafety" value="simulated-no-email" /><zeebe:header key="integrationMapping" value="correspondence.dispatch" /></zeebe:taskHeaders></bpmn:extensionElements><bpmn:incoming>Flow_AdminOK</bpmn:incoming><bpmn:incoming>Flow_RetryDispatch</bpmn:incoming><bpmn:outgoing>Flow_DispatchSent</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="Retry" name="Resolve failure / authorise retry"><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="clinic-letter-dispatch-retry-sprint02" bindingType="deployment" /><zeebe:assignmentDefinition candidateGroups="medical-secretaries" /><zeebe:ioMapping><zeebe:output source="= dispatchResolution" target="dispatchResolution" /><zeebe:output source="= retryAuthorised" target="retryAuthorised" /><zeebe:output source="= simulateDispatchError" target="simulateDispatchError" /><zeebe:output source="= delayReason" target="delayReason" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_DispatchError</bpmn:incoming><bpmn:incoming>Flow_RetryHold</bpmn:incoming><bpmn:outgoing>Flow_RetryDecision</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="RetryReady" name="Retry authorised?" default="Flow_RetryHold"><bpmn:incoming>Flow_RetryDecision</bpmn:incoming><bpmn:outgoing>Flow_RetryDispatch</bpmn:outgoing><bpmn:outgoing>Flow_RetryHold</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="Sent" name="Sent; cancel ALL monitoring"><bpmn:incoming>Flow_DispatchSent</bpmn:incoming><bpmn:terminateEventDefinition /></bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="SevenDays" name="Seven days from consultation"><bpmn:incoming>Flow_StartMonitoring</bpmn:incoming><bpmn:outgoing>Flow_FirstReminder</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeDate>= date and time(consultationCompletedAt) + duration(&quot;P7D&quot;)</bpmn:timeDate></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Reminder" name="Record delay / weekly reminder"><bpmn:extensionElements><zeebe:taskDefinition type="clinic-letter.sprint02.reminder" retries="3" /><zeebe:taskHeaders><zeebe:header key="demoSafety" value="simulated-no-email" /></zeebe:taskHeaders></bpmn:extensionElements><bpmn:incoming>Flow_FirstReminder</bpmn:incoming><bpmn:incoming>Flow_ReminderLoop</bpmn:incoming><bpmn:outgoing>Flow_WaitWeek</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Week" name="Wait one week"><bpmn:incoming>Flow_WaitWeek</bpmn:incoming><bpmn:outgoing>Flow_ReminderLoop</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeDuration>P7D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="OneMonth" name="One calendar month from consultation"><bpmn:incoming>Flow_StartMonth</bpmn:incoming><bpmn:outgoing>Flow_MonthEscalation</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeDate>= date and time(consultationCompletedAt) + duration(&quot;P1M&quot;)</bpmn:timeDate></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="EscalateMonth" name="Notify Administrative Manager"><bpmn:extensionElements><zeebe:taskDefinition type="clinic-letter.sprint02.escalate-one-month" retries="3" /><zeebe:taskHeaders><zeebe:header key="demoSafety" value="simulated-no-email" /></zeebe:taskHeaders></bpmn:extensionElements><bpmn:incoming>Flow_MonthEscalation</bpmn:incoming><bpmn:outgoing>Flow_MonthRecorded</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="MonthDone" name="One-month notification recorded"><bpmn:incoming>Flow_MonthRecorded</bpmn:incoming></bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="ThreeMonths" name="Three calendar months from consultation"><bpmn:incoming>Flow_StartThree</bpmn:incoming><bpmn:outgoing>Flow_ThreeEscalation</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeDate>= date and time(consultationCompletedAt) + duration(&quot;P3M&quot;)</bpmn:timeDate></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="EscalateThree" name="Notify Higher Management"><bpmn:extensionElements><zeebe:taskDefinition type="clinic-letter.sprint02.escalate-three-months" retries="3" /><zeebe:taskHeaders><zeebe:header key="demoSafety" value="simulated-no-email" /></zeebe:taskHeaders></bpmn:extensionElements><bpmn:incoming>Flow_ThreeEscalation</bpmn:incoming><bpmn:outgoing>Flow_ThreeRecorded</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="ThreeDone" name="Three-month notification recorded"><bpmn:incoming>Flow_ThreeRecorded</bpmn:incoming></bpmn:endEvent>
    <bpmn:boundaryEvent id="DispatchError" name="Dispatch rejected" attachedToRef="Dispatch" cancelActivity="true"><bpmn:outgoing>Flow_DispatchError</bpmn:outgoing><bpmn:errorEventDefinition errorRef="Error_DispatchRejected" /></bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_StartSplit" sourceRef="Start" targetRef="Split"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_StartDraft" sourceRef="Split" targetRef="RecordDraftStart"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RecordDraft" sourceRef="RecordDraftStart" targetRef="Draft"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DraftApproval" sourceRef="Draft" targetRef="Approve"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ApprovalDecision" sourceRef="Approve" targetRef="Approved"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Approved" sourceRef="Approved" targetRef="Admin" name="Approved"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= clinicalApproved = true</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Rejected" sourceRef="Approved" targetRef="RecordDraftStart" name="Rejected / rework"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ClinicalCorrection" sourceRef="AdminReady" targetRef="RecordDraftStart" name="Clinical review required"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= clinicalCorrectionRequested = true</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AdminDecision" sourceRef="Admin" targetRef="AdminReady"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AdminOK" sourceRef="AdminReady" targetRef="Dispatch" name="Complete"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= recipientChecked = true and administrativeDetailsChecked = true and clinicalCorrectionRequested != true</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AdminIncomplete" sourceRef="AdminReady" targetRef="Admin" name="Incomplete"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DispatchSent" sourceRef="Dispatch" targetRef="Sent"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DispatchError" sourceRef="DispatchError" targetRef="Retry"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RetryDecision" sourceRef="Retry" targetRef="RetryReady"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RetryDispatch" sourceRef="RetryReady" targetRef="Dispatch" name="Retry"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= retryAuthorised = true</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RetryHold" sourceRef="RetryReady" targetRef="Retry" name="Not yet"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_StartMonitoring" sourceRef="Split" targetRef="SevenDays"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_FirstReminder" sourceRef="SevenDays" targetRef="Reminder"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_WaitWeek" sourceRef="Reminder" targetRef="Week"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ReminderLoop" sourceRef="Week" targetRef="Reminder"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_StartMonth" sourceRef="Split" targetRef="OneMonth"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_MonthEscalation" sourceRef="OneMonth" targetRef="EscalateMonth"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_MonthRecorded" sourceRef="EscalateMonth" targetRef="MonthDone"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_StartThree" sourceRef="Split" targetRef="ThreeMonths"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ThreeEscalation" sourceRef="ThreeMonths" targetRef="EscalateThree"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ThreeRecorded" sourceRef="EscalateThree" targetRef="ThreeDone"></bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_ClinicLetter"><bpmndi:BPMNPlane id="Plane_ClinicLetter" bpmnElement="Process_ClinicLetterSprint02">
    <bpmndi:BPMNShape id="Shape_Lane_Consultant" bpmnElement="Lane_Consultant" isHorizontal="true"><dc:Bounds x="30" y="30" width="1850" height="200" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Lane_Secretary" bpmnElement="Lane_Secretary" isHorizontal="true"><dc:Bounds x="30" y="230" width="1850" height="350" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Lane_Pathway" bpmnElement="Lane_Pathway" isHorizontal="true"><dc:Bounds x="30" y="580" width="1850" height="210" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Lane_Management" bpmnElement="Lane_Management" isHorizontal="true"><dc:Bounds x="30" y="790" width="1850" height="370" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Start" bpmnElement="Start"><dc:Bounds x="120" y="110" width="38" height="38" /></bpmndi:BPMNShape>
