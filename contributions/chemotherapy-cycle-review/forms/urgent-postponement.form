{
  "components": [
    {
      "label": "Urgent clinical reason for safety hold",
      "type": "textarea",
      "key": "urgentReason",
      "validate": {
        "required": true
      },
      "id": "urgentReason"
    },
    {
      "label": "Authorised clinician name or reference",
      "type": "textfield",
      "key": "urgentAuthoriser",
      "validate": {
        "required": true
      },
      "id": "urgentAuthoriser"
    },
    {
      "label": "Date and time of urgent hold",
      "type": "textfield",
      "key": "urgentHoldDateTime",
      "validate": {
        "required": true
      },
      "id": "urgentHoldDateTime"
    }
  ],
  "type": "default",
  "id": "urgent-postponement",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.51.1"
  },
  "schemaVersion": 19
}