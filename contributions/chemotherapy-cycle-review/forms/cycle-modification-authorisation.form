{
  "components": [
    {
      "label": "Formal request received",
      "type": "checkbox",
      "key": "formalRequest",
      "validate": {
        "required": false
      },
      "id": "formalRequest"
    },
    {
      "label": "Clinically authorised",
      "type": "checkbox",
      "key": "modificationAuthorised",
      "validate": {
        "required": false
      },
      "id": "modificationAuthorised"
    },
    {
      "label": "Funding, payment or refund impact exists",
      "type": "checkbox",
      "key": "financialImpact",
      "id": "financialImpact"
    },
    {
      "label": "Treatment, cycle, dose and proposed date",
      "type": "textarea",
      "key": "proposedTreatmentChange",
      "validate": {
        "required": true
      },
      "id": "proposedTreatmentChange"
    },
    {
      "label": "Clinical reason and authoriser",
      "type": "textarea",
      "key": "clinicalReason",
      "validate": {
        "required": true
      },
      "id": "clinicalReason"
    }
  ],
  "type": "default",
  "id": "cycle-modification-authorisation",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
