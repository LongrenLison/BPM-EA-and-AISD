{
  "components": [
    {
      "label": "Missing result or service failure",
      "type": "textarea",
      "key": "missingResultReason",
      "validate": {
        "required": true
      },
      "id": "missingResultReason"
    },
    {
      "label": "Original result request ID",
      "type": "textfield",
      "key": "resultsRequestId",
      "validate": {
        "required": true
      },
      "id": "resultsRequestId"
    },
    {
      "label": "Correlation key to reuse for retry",
      "type": "textfield",
      "key": "resultsCorrelationKey",
      "validate": {
        "required": true
      },
      "id": "resultsCorrelationKey"
    },
    {
      "label": "Checked by",
      "type": "textfield",
      "key": "resultsCheckedBy",
      "validate": {
        "required": true
      },
      "id": "resultsCheckedBy"
    }
  ],
  "type": "default",
  "id": "cycle-results-retry",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.51.1"
  },
  "schemaVersion": 19
}