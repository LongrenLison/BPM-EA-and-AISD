{
  "components": [
    {
      "label": "Clinical findings and result review",
      "type": "textarea",
      "key": "clinicalFindings",
      "validate": {
        "required": true
      },
      "id": "clinicalFindings"
    },
    {
      "label": "Cycle decision",
      "values": [
        {
          "label": "Continue",
          "value": "continue"
        },
        {
          "label": "Delay",
          "value": "delay"
        },
        {
          "label": "Change treatment",
          "value": "change"
        }
      ],
      "type": "select",
      "key": "cycleDecision",
      "validate": {
        "required": true
      },
      "id": "cycleDecision"
    },
    {
      "label": "Urgent safety postponement required",
      "type": "checkbox",
      "key": "urgentPostponement",
      "id": "urgentPostponement"
    },
    {
      "label": "Clinical reason",
      "type": "textarea",
      "key": "clinicalReason",
      "validate": {
        "required": true
      },
      "id": "clinicalReason"
    }
  ],
  "type": "default",
  "id": "cycle-clinical-review",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.51.1"
  },
  "schemaVersion": 19
}