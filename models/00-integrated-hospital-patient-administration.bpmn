<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_IntegratedHospital" targetNamespace="http://hospital.example/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:message id="Message_ReferralReceived" name="Referral received" />
  <bpmn:message id="Message_PatientNotice" name="Patient notification" />
  <bpmn:collaboration id="Collaboration_IntegratedHospital">
    <bpmn:participant id="Participant_Hospital" name="Hospital Patient Administration System" processRef="Process_HospitalAdministration" />
    <bpmn:participant id="Participant_1sc4nts" name="Patient or authorised representative" processRef="Process_0w6eap2" />
    <bpmn:messageFlow id="MF_ReferralReceived" sourceRef="Participant_1sc4nts" targetRef="Start_Journey" messageRef="Message_ReferralReceived" />
    <bpmn:messageFlow id="MF_AppointmentNotice" sourceRef="R_Notify" targetRef="Participant_1sc4nts" messageRef="Message_PatientNotice" />
    <bpmn:messageFlow id="MF_EnquiryResolution" sourceRef="Q_SendNotification" targetRef="Participant_1sc4nts" messageRef="Message_PatientNotice" />
    <bpmn:textAnnotation id="TA_ReferralResponsibility">
      <bpmn:text>Medical Secretaries check document completeness only. A Consultant makes the clinical referral decision.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TA_AppointmentUrgency">
      <bpmn:text>If the appointment is within two weeks, telephone contact is also required. Record every attempt and outcome.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TA_TreatmentAuthorisation">
      <bpmn:text>An incomplete or unauthorised treatment request must not be processed by administrative staff.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TA_PaymentInvestigation">
      <bpmn:text>Missing provider confirmation may follow a successful payment. Investigate it; do not automatically request another payment.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TA_ClinicalEnquiryBoundary">
      <bpmn:text>Call handlers do not diagnose, interpret results or recommend treatment. Urgent clinical concerns go to qualified clinical staff.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_TA_ClinicalEnquiryBoundary" sourceRef="Q_ClinicalTriage" targetRef="TA_ClinicalEnquiryBoundary" />
    <bpmn:association id="Association_TA_ReferralResponsibility" sourceRef="R_CheckDocuments" targetRef="TA_ReferralResponsibility" />
    <bpmn:association id="Association_TA_AppointmentUrgency" sourceRef="R_PhoneNeeded" targetRef="TA_AppointmentUrgency" />
    <bpmn:association id="Association_TA_TreatmentAuthorisation" sourceRef="T_Authorised" targetRef="TA_TreatmentAuthorisation" />
    <bpmn:association id="Association_TA_PaymentInvestigation" sourceRef="T_InvestigatePayment" targetRef="TA_PaymentInvestigation" />
  </bpmn:collaboration>
  <bpmn:process id="Process_HospitalAdministration" name="Integrated hospital patient administration" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Integrated">
      <bpmn:lane id="Lane_Secretaries" name="Medical Secretaries and Call Handling Team">
        <bpmn:flowNodeRef>Start_Journey</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_CheckDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_Record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_Type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_SendNotification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Resolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_Admin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_RequestInformation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_DocumentsComplete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Consultants" name="Consultant and authorised clinical professionals">
        <bpmn:flowNodeRef>R_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Authorised</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_UrgentOverride</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Authorise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ReferralRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ReferralRedirected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_TreatmentInvalid</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Outpatients" name="Outpatient Bookings Team">
        <bpmn:flowNodeRef>R_Prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_FindAppointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_Escalate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_Availability</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_Appointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_PhoneNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_Call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_FirstAppointmentConfirmed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Pathway" name="Patient Pathway Coordinators">
        <bpmn:flowNodeRef>R_ResolveCapacity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ReferralNoCapacity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_CapacityResolution</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance" name="Finance Team">
        <bpmn:flowNodeRef>T_AssessFunding</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_FundingDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_PaymentNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_TakePayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_PaymentOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_PaymentResolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RequestPaymentStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_Funding</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0rvfygr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_InvestigatePayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_PaymentIssueClosed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TreatmentBookings" name="Treatment and Chemotherapy Bookings Team">
        <bpmn:flowNodeRef>T_CheckCapacity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ConfirmTreatment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_TreatmentConfirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_NotifyPaymentIssue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_PendingExternal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RetryCapacity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ExternalUnavailable</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CNS" name="Clinical Nurse Specialist Team">
        <bpmn:flowNodeRef>Q_ClinicalTriage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_ClinicalResponse</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CNSAdmin" name="Clinical Nurse Specialist Administrative Support">
        <bpmn:flowNodeRef>Q_SupportContact</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Journey" name="Referral received">
      <bpmn:messageEventDefinition messageRef="Message_ReferralReceived" />
    </bpmn:startEvent>
    <bpmn:userTask id="R_CheckDocuments" name="Check supporting information">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="referral-document-check" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="R_Review" name="Review referral clinically">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="referral-clinical-decision" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="R_Prepare" name="Prepare authorised booking request">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="hospital-task-update" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="R_FindAppointment" name="Find suitable appointment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="scheduling.search" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="R_ResolveCapacity" name="Review pathway capacity">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="referral-capacity-resolution" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:endEvent id="End_ReferralNoCapacity" name="Referral closed: no suitable capacity" />
    <bpmn:exclusiveGateway id="T_Authorised" name="Request authorised?" default="F_Treatment_Invalid" />
    <bpmn:serviceTask id="T_CheckCapacity" name="Check treatment capacity">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="treatment.capacity-check" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_Retry_Capacity</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_AssessFunding" name="Assess funding arrangement">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="funding.assess" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_FundingDecision" name="Record funding approval or limitation">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="treatment-funding-decision" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="T_PaymentNeeded" name="Advance payment required?" default="F_Payment_Required" />
    <bpmn:serviceTask id="T_TakePayment" name="Request secure payment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="payment.request" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="T_PaymentOutcome" name="Payment outcome" default="F_Payment_Investigate">
      <bpmn:incoming>F_Payment_Outcome</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="T_PaymentResolution" name="Payment resolution" default="F_PaymentResolution_Close" />
    <bpmn:serviceTask id="T_RequestPaymentStatus" name="Request provider payment status">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="payment.status.request" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_UrgentOverride" name="Authorise urgent treatment override">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="treatment-urgent-override" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="T_ConfirmTreatment" name="Confirm treatment appointments">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="treatment-appointment-confirmation" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_Payment_Funded</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="T_TreatmentConfirmed" name="Treatment confirmed" />
    <bpmn:userTask id="Q_Record" name="Record, classify and assign priority">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="enquiry-classification" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_Treatment_Enquiry</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Q_Type" name="Enquiry type?" default="F_Enquiry_Clinical" />
    <bpmn:userTask id="Q_Funding" name="Answer funding or payment query">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="enquiry-funding-response" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="Q_ClinicalTriage" name="Triage clinical concern">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="enquiry-clinical-triage" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_Enquiry_Clinical</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:userTask id="Q_ClinicalResponse" name="Provide authorised clinical response">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="enquiry-clinical-response" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="Q_SupportContact" name="Record specialist support contact">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="enquiry-support-contact" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="Q_Notify" name="Record response and notify patient">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="enquiry-resolution-notification" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="Q_SendNotification" name="Send enquiry resolution notification">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notifications.send" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Resolved" name="Patient journey resolved" />
    <bpmn:userTask id="R_Escalate" name="Highlight unavailable timeframe">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="hospital-task-update" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="R_Availability" name="Slot within timeframe?" default="F_Slot_No" />
    <bpmn:userTask id="R_Confirm" name="Confirm appointment">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="hospital-task-update" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="Q_Appointment" name="Resolve appointment query">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="enquiry-appointment-response" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="Q_Admin" name="Answer authorised administrative query">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="enquiry-admin-response" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_0rvfygr" name="Receive provider payment status">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="payment.status.request" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_Status_Await</bpmn:incoming>
      <bpmn:outgoing>F_Await_Outcome</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_NotifyPaymentIssue" name="Notify patient and record payment resolution">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="treatment-payment-investigation" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="T_PendingExternal" name="Record pending booking and notify owner">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="hospital-task-update" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="T_RetryCapacity" name="Retry after service recovery">
      <bpmn:outgoing>F_Retry_Capacity</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>PT30M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="T_Authorise" name="Record consent and authorise request">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="treatment-authorisation" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="R_Notify" name="Send appointment letter">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notifications.send" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="R_PhoneNeeded" name="Within two weeks?" default="F_Phone_Yes" />
    <bpmn:userTask id="R_Call" name="Telephone patient and record outcome">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="hospital-task-update" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="R_FirstAppointmentConfirmed" name="First appointment confirmed" />
    <bpmn:serviceTask id="R_RequestInformation" name="Request missing information">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="referral.request-information" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="R_DocumentsComplete" name="Information complete?" default="F_Docs_No" />
    <bpmn:endEvent id="End_ReferralRejected" name="Referral rejected" />
    <bpmn:exclusiveGateway id="R_Decision" name="Consultant decision" default="F_Referral_Reject" />
    <bpmn:endEvent id="End_ReferralRedirected" name="Referral redirected" />
    <bpmn:endEvent id="End_TreatmentInvalid" name="Unauthorised request stopped" />
    <bpmn:boundaryEvent id="T_ExternalUnavailable" name="External service unavailable" attachedToRef="T_CheckCapacity">
      <bpmn:errorEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="F_Start_Check" sourceRef="Start_Journey" targetRef="R_CheckDocuments" />
    <bpmn:sequenceFlow id="F_Request_Check" sourceRef="R_RequestInformation" targetRef="R_CheckDocuments" />
    <bpmn:sequenceFlow id="F_Check_Gateway" sourceRef="R_CheckDocuments" targetRef="R_DocumentsComplete" />
    <bpmn:sequenceFlow id="F_Docs_Yes" name="yes" sourceRef="R_DocumentsComplete" targetRef="R_Review">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=documentsComplete = "complete"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Review_Decision" sourceRef="R_Review" targetRef="R_Decision" />
    <bpmn:sequenceFlow id="F_Referral_Accept" name="accept" sourceRef="R_Decision" targetRef="R_Prepare">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=referralDecision = "accept"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Prepare_Find" sourceRef="R_Prepare" targetRef="R_FindAppointment" />
    <bpmn:sequenceFlow id="F_Resolve_Capacity" sourceRef="R_ResolveCapacity" targetRef="R_CapacityResolution" />
    <bpmn:sequenceFlow id="F_Capacity_Retry" name="search again" sourceRef="R_CapacityResolution" targetRef="R_FindAppointment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=capacityResolution = "retry"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Capacity_Manual" name="manual appointment" sourceRef="R_CapacityResolution" targetRef="R_Confirm">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=capacityResolution = "manualAppointment"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Capacity_Close" name="close referral" sourceRef="R_CapacityResolution" targetRef="End_ReferralNoCapacity" />
    <bpmn:sequenceFlow id="F_Find_Availability" sourceRef="R_FindAppointment" targetRef="R_Availability" />
    <bpmn:sequenceFlow id="F_Escalate_Resolve" sourceRef="R_Escalate" targetRef="R_ResolveCapacity" />
    <bpmn:sequenceFlow id="F_Treatment_Authorised" sourceRef="T_Authorise" targetRef="T_Authorised" />
    <bpmn:sequenceFlow id="F_Treatment_Invalid" name="no" sourceRef="T_Authorised" targetRef="End_TreatmentInvalid" />
    <bpmn:sequenceFlow id="F_Treatment_Valid" name="yes" sourceRef="T_Authorised" targetRef="T_CheckCapacity">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=treatmentRequestAuthorised = "authorised"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Retry_Capacity" sourceRef="T_RetryCapacity" targetRef="T_CheckCapacity" />
    <bpmn:sequenceFlow id="F_Capacity_Funding" sourceRef="T_CheckCapacity" targetRef="T_AssessFunding" />
    <bpmn:sequenceFlow id="F_Funding_Decision" sourceRef="T_AssessFunding" targetRef="T_FundingDecision" />
    <bpmn:sequenceFlow id="F_Decision_Payment" sourceRef="T_FundingDecision" targetRef="T_PaymentNeeded" />
    <bpmn:sequenceFlow id="F_Payment_Required" name="payment required" sourceRef="T_PaymentNeeded" targetRef="T_TakePayment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=advancePaymentRequired</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Payment_Funded" name="no payment" sourceRef="T_PaymentNeeded" targetRef="T_ConfirmTreatment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(advancePaymentRequired)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_NotifyIssue_Payment" sourceRef="T_NotifyPaymentIssue" targetRef="T_PaymentResolution" />
    <bpmn:sequenceFlow id="F_Payment_Outcome" sourceRef="T_TakePayment" targetRef="T_PaymentOutcome" />
    <bpmn:sequenceFlow id="F_Await_Outcome" name="status received" sourceRef="Activity_0rvfygr" targetRef="T_InvestigatePayment" />
    <bpmn:sequenceFlow id="F_Payment_Success" name="completed" sourceRef="T_PaymentOutcome" targetRef="T_ConfirmTreatment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentStatus = "completed"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Payment_Investigate" name="confirmation missing" sourceRef="T_PaymentOutcome" targetRef="T_RequestPaymentStatus">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentStatus = "investigate"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Payment_Failed" name="declined or cancelled" sourceRef="T_PaymentOutcome" targetRef="T_NotifyPaymentIssue">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentStatus = "declined" or paymentStatus = "cancelled"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Investigate_Resolution" sourceRef="T_InvestigatePayment" targetRef="T_PaymentResolution" />
    <bpmn:sequenceFlow id="F_PaymentResolution_Completed" name="completed" sourceRef="T_PaymentResolution" targetRef="T_ConfirmTreatment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentStatus = "completed"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_PaymentResolution_Retry" name="retry payment" sourceRef="T_PaymentResolution" targetRef="T_TakePayment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentStatus = "retry"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_PaymentResolution_Urgent" name="urgent clinical risk" sourceRef="T_PaymentResolution" targetRef="T_UrgentOverride">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentStatus = "urgent"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_PaymentResolution_Close" name="close booking" sourceRef="T_PaymentResolution" targetRef="End_PaymentIssueClosed" />
    <bpmn:sequenceFlow id="F_Payment_Urgent" name="urgent clinical risk" sourceRef="T_PaymentOutcome" targetRef="T_UrgentOverride">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentStatus = "urgent"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Status_Await" sourceRef="T_RequestPaymentStatus" targetRef="Activity_0rvfygr" />
    <bpmn:sequenceFlow id="F_Urgent_Confirm" sourceRef="T_UrgentOverride" targetRef="T_ConfirmTreatment" />
    <bpmn:sequenceFlow id="F_Confirm_TreatmentDone" sourceRef="T_ConfirmTreatment" targetRef="T_TreatmentConfirmed" />
    <bpmn:sequenceFlow id="F_Treatment_Enquiry" sourceRef="T_TreatmentConfirmed" targetRef="Q_Record" />
    <bpmn:sequenceFlow id="F_Enquiry_Type" sourceRef="Q_Record" targetRef="Q_Type" />
    <bpmn:sequenceFlow id="F_Enquiry_Admin" name="administrative" sourceRef="Q_Type" targetRef="Q_Admin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=enquiryType = "administrative"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Enquiry_Appointment" name="appointment" sourceRef="Q_Type" targetRef="Q_Appointment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=enquiryType = "appointment"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Enquiry_Funding" name="financial" sourceRef="Q_Type" targetRef="Q_Funding">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=enquiryType = "financial"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Enquiry_Clinical" name="clinical including urgent" sourceRef="Q_Type" targetRef="Q_ClinicalTriage">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=enquiryType = "clinical"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Funding_Notify" sourceRef="Q_Funding" targetRef="Q_Notify" />
    <bpmn:sequenceFlow id="F_Triage_Response" sourceRef="Q_ClinicalTriage" targetRef="Q_ClinicalResponse" />
    <bpmn:sequenceFlow id="F_Response_Support" sourceRef="Q_ClinicalResponse" targetRef="Q_SupportContact" />
    <bpmn:sequenceFlow id="F_Support_Notify" sourceRef="Q_SupportContact" targetRef="Q_Notify" />
    <bpmn:sequenceFlow id="F_Admin_Notify" sourceRef="Q_Admin" targetRef="Q_Notify" />
    <bpmn:sequenceFlow id="F_Appointment_Notify" sourceRef="Q_Appointment" targetRef="Q_Notify" />
    <bpmn:sequenceFlow id="F_Notify_Send" sourceRef="Q_Notify" targetRef="Q_SendNotification" />
    <bpmn:sequenceFlow id="F_Notify_End" sourceRef="Q_SendNotification" targetRef="End_Resolved" />
    <bpmn:sequenceFlow id="F_Slot_No" name="no" sourceRef="R_Availability" targetRef="R_Escalate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(slotFound)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Slot_Yes" name="yes" sourceRef="R_Availability" targetRef="R_Confirm">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=slotFound</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Confirm_Notify" sourceRef="R_Confirm" targetRef="R_Notify" />
    <bpmn:sequenceFlow id="F_Capacity_Unavailable" sourceRef="T_ExternalUnavailable" targetRef="T_PendingExternal" />
    <bpmn:sequenceFlow id="F_Pending_Retry" sourceRef="T_PendingExternal" targetRef="T_RetryCapacity" />
    <bpmn:sequenceFlow id="F_Appointment_Treatment" sourceRef="R_FirstAppointmentConfirmed" targetRef="T_Authorise" />
    <bpmn:sequenceFlow id="F_Notify_Phone" sourceRef="R_Notify" targetRef="R_PhoneNeeded" />
    <bpmn:sequenceFlow id="F_Phone_Yes" name="yes" sourceRef="R_PhoneNeeded" targetRef="R_Call">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=appointmentWithinTwoWeeks</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Phone_No" name="no" sourceRef="R_PhoneNeeded" targetRef="R_FirstAppointmentConfirmed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(appointmentWithinTwoWeeks)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Call_AppointmentConfirmed" sourceRef="R_Call" targetRef="R_FirstAppointmentConfirmed" />
    <bpmn:sequenceFlow id="F_Docs_No" name="no" sourceRef="R_DocumentsComplete" targetRef="R_RequestInformation" />
    <bpmn:sequenceFlow id="F_Referral_MoreInfo" name="more information" sourceRef="R_Decision" targetRef="R_RequestInformation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=referralDecision = "moreInfo"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Referral_Reject" name="reject" sourceRef="R_Decision" targetRef="End_ReferralRejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=referralDecision = "reject"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Referral_Redirect" name="redirect" sourceRef="R_Decision" targetRef="End_ReferralRedirected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=referralDecision = "redirect"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="R_CapacityResolution" name="Capacity resolution" default="F_Capacity_Close" />
    <bpmn:userTask id="T_InvestigatePayment" name="Investigate and resolve payment issue">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="treatment-payment-investigation" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:endEvent id="End_PaymentIssueClosed" name="Booking closed after payment issue" />
  </bpmn:process>
