        <dc:Bounds x="2640" y="495" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndBooked_di" bpmnElement="EndBooked">
        <dc:Bounds x="2790" y="512" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2777" y="548" width="62" height="27" />
        </bpmndi:BPMNLabel>
