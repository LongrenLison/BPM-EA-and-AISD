<?xml version="1.0" encoding="utf-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_Referral" targetNamespace="http://hospital.example/bpmn">
  <bpmn:collaboration id="Collaboration_Referral">
    <bpmn:participant id="Hospital_Referral" name="Hospital Patient Administration System" processRef="Process_Referral" />
    <bpmn:participant id="Referrer" name="Referring organisation" />
    <bpmn:participant id="Patient_Referral" name="Patient" />
    <bpmn:participant id="Scheduling" name="External scheduling service" />
    <bpmn:participant id="Correspondence" name="External correspondence service" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Referral" name="Referral and first appointment" isExecutable="true">
    <bpmn:laneSet id="Lanes_Referral">
      <bpmn:lane id="L_MS" name="Medical Secretaries">
        <bpmn:flowNodeRef>Start_Referral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CheckDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RequestInformation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Consultant" name="Consultant">
        <bpmn:flowNodeRef>ReviewReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndRedirected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Booking" name="Outpatient Bookings Team">
        <bpmn:flowNodeRef>PrepareRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FindAppointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Availability</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EscalateNoSlot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ConfirmAppointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NotifyPatient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PhoneNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CallPatient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndBooked</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Pathway" name="Patient Pathway Coordinators">
        <bpmn:flowNodeRef>ResolveCapacity</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Referral" name="Referral received" />
    <bpmn:userTask id="CheckDocuments" name="Check supporting information" />
    <bpmn:exclusiveGateway id="DocumentsComplete" name="Information complete?" default="F_DocsNo" />
    <bpmn:serviceTask id="RequestInformation" name="Request missing information">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="referral.request-information" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="ReviewReferral" name="Review referral clinically" />
    <bpmn:exclusiveGateway id="Decision" name="Consultant decision" />
    <bpmn:endEvent id="EndRejected" name="Referral rejected" />
    <bpmn:endEvent id="EndRedirected" name="Referral redirected" />
    <bpmn:userTask id="PrepareRequest" name="Prepare authorised booking request" />
    <bpmn:serviceTask id="FindAppointment" name="Find suitable appointment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="scheduling.search" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Availability" name="Slot within timeframe?" />
    <bpmn:userTask id="EscalateNoSlot" name="Highlight unavailable timeframe" />
    <bpmn:userTask id="ResolveCapacity" name="Review pathway capacity" />
    <bpmn:userTask id="ConfirmAppointment" name="Confirm appointment" />
    <bpmn:serviceTask id="NotifyPatient" name="Send appointment letter">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="correspondence.dispatch" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="PhoneNeeded" name="Within two weeks?" />
    <bpmn:userTask id="CallPatient" name="Telephone patient and record outcome" />
    <bpmn:endEvent id="EndBooked" name="Appointment confirmed" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_Referral" targetRef="CheckDocuments" />
    <bpmn:sequenceFlow id="F2" sourceRef="CheckDocuments" targetRef="DocumentsComplete" />
    <bpmn:sequenceFlow id="F_DocsYes" name="yes" sourceRef="DocumentsComplete" targetRef="ReviewReferral">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=documentsComplete</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_DocsNo" name="no" sourceRef="DocumentsComplete" targetRef="RequestInformation" />
    <bpmn:sequenceFlow id="F3" sourceRef="RequestInformation" targetRef="CheckDocuments" />
    <bpmn:sequenceFlow id="F4" sourceRef="ReviewReferral" targetRef="Decision" />
    <bpmn:sequenceFlow id="F_Reject" name="reject" sourceRef="Decision" targetRef="EndRejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=referralDecision = "reject"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Redirect" name="redirect" sourceRef="Decision" targetRef="EndRedirected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=referralDecision = "redirect"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_MoreInfo" name="more information" sourceRef="Decision" targetRef="RequestInformation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=referralDecision = "moreInfo"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Accept" name="accept" sourceRef="Decision" targetRef="PrepareRequest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=referralDecision = "accept"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F5" sourceRef="PrepareRequest" targetRef="FindAppointment" />
    <bpmn:sequenceFlow id="F6" sourceRef="FindAppointment" targetRef="Availability" />
    <bpmn:sequenceFlow id="F_Slot" name="yes" sourceRef="Availability" targetRef="ConfirmAppointment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=slotFound</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_NoSlot" name="no" sourceRef="Availability" targetRef="EscalateNoSlot">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(slotFound)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F7" sourceRef="EscalateNoSlot" targetRef="ResolveCapacity" />
    <bpmn:sequenceFlow id="F8" sourceRef="ResolveCapacity" targetRef="FindAppointment" />
    <bpmn:sequenceFlow id="F9" sourceRef="ConfirmAppointment" targetRef="NotifyPatient" />
    <bpmn:sequenceFlow id="F10" sourceRef="NotifyPatient" targetRef="PhoneNeeded" />
    <bpmn:sequenceFlow id="F_Call" name="yes" sourceRef="PhoneNeeded" targetRef="CallPatient">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=appointmentWithinTwoWeeks</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_End" name="no" sourceRef="PhoneNeeded" targetRef="EndBooked">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(appointmentWithinTwoWeeks)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F11" sourceRef="CallPatient" targetRef="EndBooked" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Referral">
    <bpmndi:BPMNPlane id="Plane_Referral" bpmnElement="Collaboration_Referral">
      <bpmndi:BPMNShape id="PoolR" bpmnElement="Hospital_Referral" isHorizontal="true">
        <dc:Bounds x="70" y="80" width="3900" height="640" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LaneMS" bpmnElement="L_MS">
        <dc:Bounds x="100" y="80" width="3900" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LaneCon" bpmnElement="L_Consultant">
        <dc:Bounds x="100" y="240" width="3900" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LaneBook" bpmnElement="L_Booking">
        <dc:Bounds x="100" y="400" width="3900" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LanePath" bpmnElement="L_Pathway">
        <dc:Bounds x="100" y="560" width="3900" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PoolRef" bpmnElement="Referrer" isHorizontal="true">
        <dc:Bounds x="70" y="750" width="3900" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PoolPat" bpmnElement="Patient_Referral" isHorizontal="true">
        <dc:Bounds x="70" y="840" width="3900" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PoolSch" bpmnElement="Scheduling" isHorizontal="true">
        <dc:Bounds x="70" y="930" width="3900" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PoolCor" bpmnElement="Correspondence" isHorizontal="true">
        <dc:Bounds x="70" y="1020" width="3900" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Referral_di" bpmnElement="Start_Referral">
        <dc:Bounds x="150" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CheckDocuments_di" bpmnElement="CheckDocuments">
        <dc:Bounds x="300" y="125" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DocumentsComplete_di" bpmnElement="DocumentsComplete">
        <dc:Bounds x="450" y="135" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RequestInformation_di" bpmnElement="RequestInformation">
        <dc:Bounds x="600" y="125" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReviewReferral_di" bpmnElement="ReviewReferral">
        <dc:Bounds x="750" y="285" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Decision_di" bpmnElement="Decision">
        <dc:Bounds x="900" y="295" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndRejected_di" bpmnElement="EndRejected">
        <dc:Bounds x="1050" y="302" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndRedirected_di" bpmnElement="EndRedirected">
        <dc:Bounds x="1200" y="302" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PrepareRequest_di" bpmnElement="PrepareRequest">
        <dc:Bounds x="1350" y="445" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FindAppointment_di" bpmnElement="FindAppointment">
        <dc:Bounds x="1500" y="445" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Availability_di" bpmnElement="Availability">
        <dc:Bounds x="1650" y="455" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EscalateNoSlot_di" bpmnElement="EscalateNoSlot">
        <dc:Bounds x="1800" y="445" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ResolveCapacity_di" bpmnElement="ResolveCapacity">
        <dc:Bounds x="1950" y="605" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ConfirmAppointment_di" bpmnElement="ConfirmAppointment">
        <dc:Bounds x="2100" y="445" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="NotifyPatient_di" bpmnElement="NotifyPatient">
        <dc:Bounds x="2250" y="445" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PhoneNeeded_di" bpmnElement="PhoneNeeded">
        <dc:Bounds x="2400" y="455" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CallPatient_di" bpmnElement="CallPatient">
        <dc:Bounds x="2550" y="445" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndBooked_di" bpmnElement="EndBooked">
        <dc:Bounds x="2700" y="462" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1">
        <di:waypoint x="186" y="160" />
        <di:waypoint x="300" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2">
        <di:waypoint x="420" y="160" />
        <di:waypoint x="450" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_DocsYes_di" bpmnElement="F_DocsYes">
        <di:waypoint x="500" y="160" />
        <di:waypoint x="750" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_DocsNo_di" bpmnElement="F_DocsNo">
        <di:waypoint x="500" y="160" />
        <di:waypoint x="600" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3">
        <di:waypoint x="720" y="160" />
        <di:waypoint x="300" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4">
        <di:waypoint x="870" y="320" />
        <di:waypoint x="900" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Reject_di" bpmnElement="F_Reject">
        <di:waypoint x="950" y="320" />
        <di:waypoint x="1050" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Redirect_di" bpmnElement="F_Redirect">
        <di:waypoint x="950" y="320" />
        <di:waypoint x="1200" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_MoreInfo_di" bpmnElement="F_MoreInfo">
        <di:waypoint x="950" y="320" />
        <di:waypoint x="600" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Accept_di" bpmnElement="F_Accept">
        <di:waypoint x="950" y="320" />
        <di:waypoint x="1350" y="480" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5">
        <di:waypoint x="1470" y="480" />
        <di:waypoint x="1500" y="480" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6">
        <di:waypoint x="1620" y="480" />
        <di:waypoint x="1650" y="480" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Slot_di" bpmnElement="F_Slot">
        <di:waypoint x="1700" y="480" />
        <di:waypoint x="2100" y="480" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_NoSlot_di" bpmnElement="F_NoSlot">
        <di:waypoint x="1700" y="480" />
        <di:waypoint x="1800" y="480" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7">
        <di:waypoint x="1920" y="480" />
        <di:waypoint x="1950" y="640" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8">
        <di:waypoint x="2070" y="640" />
        <di:waypoint x="1500" y="480" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9">
        <di:waypoint x="2220" y="480" />
        <di:waypoint x="2250" y="480" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10">
        <di:waypoint x="2370" y="480" />
        <di:waypoint x="2400" y="480" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Call_di" bpmnElement="F_Call">
        <di:waypoint x="2450" y="480" />
        <di:waypoint x="2550" y="480" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_End_di" bpmnElement="F_End">
        <di:waypoint x="2450" y="480" />
        <di:waypoint x="2700" y="480" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11">
        <di:waypoint x="2670" y="480" />
        <di:waypoint x="2700" y="480" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>