      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="PoolRef" bpmnElement="Referrer" isHorizontal="true">
        <dc:Bounds x="160" y="810" width="3900" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PoolPat" bpmnElement="Patient_Referral" isHorizontal="true">
        <dc:Bounds x="160" y="900" width="3900" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PoolSch" bpmnElement="Scheduling" isHorizontal="true">
        <dc:Bounds x="160" y="990" width="3900" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PoolCor" bpmnElement="Correspondence" isHorizontal="true">
        <dc:Bounds x="160" y="1070" width="3900" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Message_MF_ReferralReceived_di" bpmnElement="MF_ReferralReceived">
        <di:waypoint x="2110" y="845" />
        <di:waypoint x="258" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Message_MF_RequestMissingInfo_di" bpmnElement="MF_RequestMissingInfo">
        <di:waypoint x="1015" y="210" />
        <di:waypoint x="2110" y="845" />
      </bpmndi:BPMNEdge>
