<?xml version="1.0" encoding="utf-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_Referral" targetNamespace="http://hospital.example/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.0">
  <bpmn:message id="Message_MF_ReferralReceived" name="Referral and supporting documents" />
  <bpmn:message id="Message_MF_RequestMissingInfo" name="Request for missing information" />
  <bpmn:message id="Message_MF_AppointmentLetter" name="Appointment letter request" />
  <bpmn:message id="Message_MF_AppointmentNotification" name="Appointment notification" />
  <bpmn:collaboration id="Collaboration_Referral">
    <bpmn:participant id="Hospital_Referral" name="Hospital Patient Administration System" processRef="Process_Referral" />
    <bpmn:participant id="Referrer" name="Referring organisation" />
    <bpmn:participant id="Patient_Referral" name="Patient" />
    <bpmn:participant id="Scheduling" name="External scheduling service" />
    <bpmn:participant id="Correspondence" name="External correspondence service" />
    <bpmn:messageFlow id="MF_ReferralReceived" name="Referral and supporting documents" sourceRef="Referrer" targetRef="Start_Referral" messageRef="Message_MF_ReferralReceived" />
    <bpmn:messageFlow id="MF_RequestMissingInfo" name="Request for missing information" sourceRef="RequestInformation" targetRef="Referrer" messageRef="Message_MF_RequestMissingInfo" />
    <bpmn:messageFlow id="MF_AppointmentLetter" name="Appointment letter request" sourceRef="NotifyPatient" targetRef="Correspondence" messageRef="Message_MF_AppointmentLetter" />
    <bpmn:messageFlow id="MF_AppointmentNotification" name="Appointment notification" sourceRef="Correspondence" targetRef="Patient_Referral" messageRef="Message_MF_AppointmentNotification" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Referral" name="Referral and first appointment" isExecutable="true">
    <bpmn:laneSet id="Lanes_Referral">
      <bpmn:lane id="L_Pathway" name="Patient Pathway Coordinators">
        <bpmn:flowNodeRef>ResolveCapacity</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Booking" name="Outpatient Bookings Team">
        <bpmn:flowNodeRef>PrepareRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FindAppointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Availability</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EscalateNoSlot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ConfirmAppointment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NotifyPatient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PhoneNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CallPatient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndBooked</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Consultant" name="Consultant">
        <bpmn:flowNodeRef>ReviewReferral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndRedirected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_MS" name="Medical Secretaries">
        <bpmn:flowNodeRef>Start_Referral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CheckDocuments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DocumentsComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RequestInformation</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Referral" name="Referral received" />
    <bpmn:userTask id="CheckDocuments" name="Check supporting information" />
    <bpmn:exclusiveGateway id="DocumentsComplete" name="Information complete?" default="F_DocsNo" />
    <bpmn:userTask id="ReviewReferral" name="Review referral clinically" />
    <bpmn:exclusiveGateway id="Decision" name="Consultant decision" />
    <bpmn:endEvent id="EndRejected" name="Referral rejected" />
    <bpmn:endEvent id="EndRedirected" name="Referral redirected" />
    <bpmn:userTask id="PrepareRequest" name="Prepare authorised booking request" />
    <bpmn:serviceTask id="FindAppointment" name="Find suitable appointment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="scheduling.search" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Availability" name="Slot within timeframe?" />
    <bpmn:userTask id="EscalateNoSlot" name="Highlight unavailable timeframe" />
    <bpmn:userTask id="ConfirmAppointment" name="Confirm appointment" />
    <bpmn:serviceTask id="NotifyPatient" name="Send appointment letter">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="correspondence.dispatch" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="PhoneNeeded" name="Within two weeks?" />
    <bpmn:userTask id="CallPatient" name="Telephone patient and record outcome" />
    <bpmn:endEvent id="EndBooked" name="Appointment confirmed" />
    <bpmn:serviceTask id="RequestInformation" name="Request missing information">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="referral.request-information" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="ResolveCapacity" name="Review pathway capacity" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_Referral" targetRef="CheckDocuments" />
    <bpmn:sequenceFlow id="F3" sourceRef="RequestInformation" targetRef="CheckDocuments" />
    <bpmn:sequenceFlow id="F2" sourceRef="CheckDocuments" targetRef="DocumentsComplete" />
    <bpmn:sequenceFlow id="F_DocsYes" name="yes" sourceRef="DocumentsComplete" targetRef="ReviewReferral">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=documentsComplete</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_DocsNo" name="no" sourceRef="DocumentsComplete" targetRef="RequestInformation" />
    <bpmn:sequenceFlow id="F4" sourceRef="ReviewReferral" targetRef="Decision" />
    <bpmn:sequenceFlow id="F_Reject" name="reject" sourceRef="Decision" targetRef="EndRejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=referralDecision = "reject"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Redirect" name="redirect" sourceRef="Decision" targetRef="EndRedirected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=referralDecision = "redirect"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_MoreInfo" name="more information" sourceRef="Decision" targetRef="RequestInformation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=referralDecision = "moreInfo"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Accept" name="accept" sourceRef="Decision" targetRef="PrepareRequest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=referralDecision = "accept"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F5" sourceRef="PrepareRequest" targetRef="FindAppointment" />
    <bpmn:sequenceFlow id="F8" sourceRef="ResolveCapacity" targetRef="FindAppointment" />
    <bpmn:sequenceFlow id="F6" sourceRef="FindAppointment" targetRef="Availability" />
    <bpmn:sequenceFlow id="F_Slot" name="yes" sourceRef="Availability" targetRef="ConfirmAppointment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=slotFound</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_NoSlot" name="no" sourceRef="Availability" targetRef="EscalateNoSlot">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(slotFound)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F7" sourceRef="EscalateNoSlot" targetRef="ResolveCapacity" />
    <bpmn:sequenceFlow id="F9" sourceRef="ConfirmAppointment" targetRef="NotifyPatient" />
    <bpmn:sequenceFlow id="F10" sourceRef="NotifyPatient" targetRef="PhoneNeeded" />
    <bpmn:sequenceFlow id="F_Call" name="yes" sourceRef="PhoneNeeded" targetRef="CallPatient">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=appointmentWithinTwoWeeks</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_End" name="no" sourceRef="PhoneNeeded" targetRef="EndBooked">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(appointmentWithinTwoWeeks)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F11" sourceRef="CallPatient" targetRef="EndBooked" />
    <bpmn:textAnnotation id="TA_SecretaryBoundary">
      <bpmn:text>Medical Secretaries check completeness only. A Consultant makes the clinical acceptance decision.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_TA_SecretaryBoundary" sourceRef="CheckDocuments" targetRef="TA_SecretaryBoundary" />
    <bpmn:textAnnotation id="TA_Timeframe">
      <bpmn:text>Do not silently book outside the Consultant requested timeframe. Escalate the capacity issue.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_TA_Timeframe" sourceRef="EscalateNoSlot" targetRef="TA_Timeframe" />
    <bpmn:textAnnotation id="TA_TwoWeeks">
      <bpmn:text>For appointments within two weeks, telephone contact is also required. Record every attempt and outcome.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_TA_TwoWeeks" sourceRef="PhoneNeeded" targetRef="TA_TwoWeeks" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Referral">
    <bpmndi:BPMNPlane id="Plane_Referral" bpmnElement="Collaboration_Referral">
      <bpmndi:BPMNShape id="PoolR" bpmnElement="Hospital_Referral" isHorizontal="true">
        <dc:Bounds x="160" y="130" width="3900" height="640" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LaneMS" bpmnElement="L_MS" isHorizontal="true">
        <dc:Bounds x="190" y="130" width="3900" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LaneCon" bpmnElement="L_Consultant" isHorizontal="true">
        <dc:Bounds x="190" y="290" width="3900" height="160" />
