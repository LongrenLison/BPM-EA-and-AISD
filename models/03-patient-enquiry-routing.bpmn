<?xml version="1.0" encoding="utf-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Enquiry" targetNamespace="http://hospital.example/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.0">
  <bpmn:message id="Message_Enquiry" name="Patient enquiry" />
  <bpmn:message id="Message_MF_PatientEnquiry" name="Patient enquiry" />
  <bpmn:message id="Message_MF_ResolutionNotice" name="Recorded response and resolution" />
  <bpmn:collaboration id="Collab_Enquiry">
    <bpmn:participant id="Hospital_Enquiry" name="Hospital Patient Administration System" processRef="Process_Enquiry" />
    <bpmn:participant id="Patient_Enquiry" name="Patient or authorised representative" />
    <bpmn:messageFlow id="MF_PatientEnquiry" name="Patient enquiry" sourceRef="Patient_Enquiry" targetRef="S_Enquiry" messageRef="Message_MF_PatientEnquiry" />
    <bpmn:messageFlow id="MF_ResolutionNotice" name="Recorded response and resolution" sourceRef="NotifyResolution" targetRef="Patient_Enquiry" messageRef="Message_MF_ResolutionNotice" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Enquiry" name="Patient enquiry routing" isExecutable="true">
    <bpmn:laneSet id="Lanes_Enquiry">
      <bpmn:lane id="LE_Outpatients" name="Outpatient Bookings Team">
        <bpmn:flowNodeRef>ResolveAppointmentQuery</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LE_Finance" name="Finance Team">
        <bpmn:flowNodeRef>AnswerFundingQuery</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LE_CNSAdmin" name="Clinical Nurse Specialist Administrative Support">
        <bpmn:flowNodeRef>RecordSupportContact</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LE_CNS" name="Clinical Nurse Specialist Team">
        <bpmn:flowNodeRef>ClinicalTriage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ProvideClinicalAdvice</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LE_Call" name="Call Handling Team">
        <bpmn:flowNodeRef>AnswerAdmin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Resolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NotifyResolution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Enquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RecordClassify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EnquiryType</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="AnswerAdmin" name="Answer authorised administrative query" />
    <bpmn:userTask id="ResolveAppointmentQuery" name="Resolve appointment query" />
    <bpmn:userTask id="ClinicalTriage" name="Triage clinical concern" />
    <bpmn:userTask id="RecordSupportContact" name="Record specialist support contact" />
    <bpmn:endEvent id="E_Resolved" name="Enquiry resolved" />
    <bpmn:userTask id="NotifyResolution" name="Record response and notify patient">
      <bpmn:incoming>Q7</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:userTask id="AnswerFundingQuery" name="Answer funding or payment query" />
    <bpmn:userTask id="ProvideClinicalAdvice" name="Provide authorised clinical response" />
    <bpmn:sequenceFlow id="Q1" sourceRef="S_Enquiry" targetRef="RecordClassify" />
    <bpmn:sequenceFlow id="Q2" sourceRef="RecordClassify" targetRef="EnquiryType" />
    <bpmn:sequenceFlow id="Q_Admin" name="administrative" sourceRef="EnquiryType" targetRef="AnswerAdmin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=enquiryType = "administrative"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Q_Appt" name="appointment" sourceRef="EnquiryType" targetRef="ResolveAppointmentQuery" />
    <bpmn:sequenceFlow id="Q_Finance" name="financial" sourceRef="EnquiryType" targetRef="AnswerFundingQuery" />
    <bpmn:sequenceFlow id="Q_Clinical" name="clinical including urgent" sourceRef="EnquiryType" targetRef="ClinicalTriage" />
    <bpmn:sequenceFlow id="Q5" sourceRef="AnswerAdmin" targetRef="NotifyResolution" />
    <bpmn:sequenceFlow id="Q6" sourceRef="ResolveAppointmentQuery" targetRef="NotifyResolution" />
    <bpmn:sequenceFlow id="Q3" sourceRef="ClinicalTriage" targetRef="ProvideClinicalAdvice" />
    <bpmn:sequenceFlow id="Q4" sourceRef="ProvideClinicalAdvice" targetRef="RecordSupportContact" />
    <bpmn:sequenceFlow id="Q8" sourceRef="RecordSupportContact" targetRef="NotifyResolution" />
    <bpmn:sequenceFlow id="Q9" sourceRef="NotifyResolution" targetRef="E_Resolved" />
    <bpmn:sequenceFlow id="Q7" sourceRef="AnswerFundingQuery" targetRef="NotifyResolution" />
    <bpmn:startEvent id="S_Enquiry" name="Enquiry received">
      <bpmn:messageEventDefinition messageRef="Message_Enquiry" />
    </bpmn:startEvent>
    <bpmn:userTask id="RecordClassify" name="Record, classify and assign priority" />
    <bpmn:exclusiveGateway id="EnquiryType" name="Enquiry type?" />
    <bpmn:textAnnotation id="TA_NoClinicalAdvice">
      <bpmn:text>Call handlers may answer authorised administrative questions but must not diagnose, interpret results or recommend treatment.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_TA_NoClinicalAdvice" sourceRef="RecordClassify" targetRef="TA_NoClinicalAdvice" />
    <bpmn:textAnnotation id="TA_UrgentClinical">
      <bpmn:text>Urgent clinical concerns are highlighted immediately and routed to an appropriately qualified clinical professional.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_TA_UrgentClinical" sourceRef="ClinicalTriage" targetRef="TA_UrgentClinical" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Enquiry">
    <bpmndi:BPMNPlane id="Plane_Enquiry" bpmnElement="Collab_Enquiry">
      <bpmndi:BPMNShape id="PoolQ" bpmnElement="Hospital_Enquiry" isHorizontal="true">
        <dc:Bounds x="160" y="200" width="4020" height="640" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LaneQO" bpmnElement="LE_Outpatients" isHorizontal="true">
        <dc:Bounds x="190" y="720" width="4020" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LaneQF" bpmnElement="LE_Finance" isHorizontal="true">
        <dc:Bounds x="190" y="620" width="4020" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LaneQNA" bpmnElement="LE_CNSAdmin" isHorizontal="true">
        <dc:Bounds x="190" y="440" width="4020" height="180" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LaneQN" bpmnElement="LE_CNS" isHorizontal="true">
        <dc:Bounds x="190" y="320" width="4020" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="LaneQC" bpmnElement="LE_Call" isHorizontal="true">
        <dc:Bounds x="190" y="200" width="4020" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EnquiryType_di" bpmnElement="EnquiryType" isMarkerVisible="true">
        <dc:Bounds x="660" y="235" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="651" y="211" width="68" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AnswerAdmin_di" bpmnElement="AnswerAdmin">
        <dc:Bounds x="810" y="225" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ResolveAppointmentQuery_di" bpmnElement="ResolveAppointmentQuery">
        <dc:Bounds x="950" y="755" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ClinicalTriage_di" bpmnElement="ClinicalTriage">
        <dc:Bounds x="1200" y="355" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RecordSupportContact_di" bpmnElement="RecordSupportContact">
        <dc:Bounds x="1550" y="525" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_Resolved_di" bpmnElement="E_Resolved">
        <dc:Bounds x="2022" y="242" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1999" y="278" width="82" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="NotifyResolution_di" bpmnElement="NotifyResolution">
        <dc:Bounds x="1800" y="225" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AnswerFundingQuery_di" bpmnElement="AnswerFundingQuery">
        <dc:Bounds x="990" y="635" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ProvideClinicalAdvice_di" bpmnElement="ProvideClinicalAdvice">
        <dc:Bounds x="1360" y="355" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Enquiry_di" bpmnElement="S_Enquiry">
        <dc:Bounds x="272" y="242" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="249" y="278" width="82" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RecordClassify_di" bpmnElement="RecordClassify">
        <dc:Bounds x="400" y="225" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Q1_di" bpmnElement="Q1">
        <di:waypoint x="308" y="260" />
        <di:waypoint x="400" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Q2_di" bpmnElement="Q2">
        <di:waypoint x="520" y="260" />
        <di:waypoint x="660" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Q_Admin_di" bpmnElement="Q_Admin">
        <di:waypoint x="710" y="260" />
        <di:waypoint x="810" y="260" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="726" y="235" width="68" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Q_Appt_di" bpmnElement="Q_Appt">
        <di:waypoint x="680" y="280" />
        <di:waypoint x="590" y="280" />
        <di:waypoint x="590" y="790" />
        <di:waypoint x="950" y="790" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="729" y="774" width="61" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Q_Finance_di" bpmnElement="Q_Finance">
        <di:waypoint x="685" y="285" />
        <di:waypoint x="685" y="670" />
        <di:waypoint x="990" y="670" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="810" y="649" width="41" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Q_Clinical_di" bpmnElement="Q_Clinical">
        <di:waypoint x="690" y="280" />
        <di:waypoint x="740" y="280" />
        <di:waypoint x="740" y="390" />
        <di:waypoint x="1200" y="390" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="928" y="365" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Q5_di" bpmnElement="Q5">
        <di:waypoint x="930" y="260" />
        <di:waypoint x="1800" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Q6_di" bpmnElement="Q6">
        <di:waypoint x="1070" y="790" />
        <di:waypoint x="2170" y="790" />
        <di:waypoint x="2170" y="80" />
        <di:waypoint x="1870" y="80" />
        <di:waypoint x="1870" y="225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Q3_di" bpmnElement="Q3">
        <di:waypoint x="1320" y="390" />
        <di:waypoint x="1360" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Q4_di" bpmnElement="Q4">
        <di:waypoint x="1480" y="390" />
        <di:waypoint x="1515" y="390" />
        <di:waypoint x="1515" y="560" />
        <di:waypoint x="1550" y="560" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Q8_di" bpmnElement="Q8">
        <di:waypoint x="1670" y="560" />
        <di:waypoint x="1860" y="560" />
        <di:waypoint x="1860" y="295" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Q9_di" bpmnElement="Q9">
        <di:waypoint x="1920" y="260" />
        <di:waypoint x="2022" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Q7_di" bpmnElement="Q7">
        <di:waypoint x="1110" y="670" />
        <di:waypoint x="1900" y="670" />
        <di:waypoint x="1900" y="295" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="PoolQP" bpmnElement="Patient_Enquiry" isHorizontal="true">
        <dc:Bounds x="160" y="890" width="4060" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Message_MF_PatientEnquiry_di" bpmnElement="MF_PatientEnquiry">
        <di:waypoint x="2190" y="930" />
        <di:waypoint x="290" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Message_MF_ResolutionNotice_di" bpmnElement="MF_ResolutionNotice">
        <di:waypoint x="1860" y="260" />
        <di:waypoint x="2190" y="930" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="TA_NoClinicalAdvice_di" bpmnElement="TA_NoClinicalAdvice">
        <dc:Bounds x="400" y="120" width="310" height="65" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Association_TA_NoClinicalAdvice_di" bpmnElement="Association_TA_NoClinicalAdvice">
        <di:waypoint x="460" y="260" />
        <di:waypoint x="555" y="152.5" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="TA_UrgentClinical_di" bpmnElement="TA_UrgentClinical">
        <dc:Bounds x="1200" y="250" width="310" height="65" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Association_TA_UrgentClinical_di" bpmnElement="Association_TA_UrgentClinical">
        <di:waypoint x="1260" y="390" />
        <di:waypoint x="1355" y="282.5" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>