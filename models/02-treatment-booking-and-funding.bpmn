        <di:waypoint x="2060" y="710" />
        <di:waypoint x="2060" y="605" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="T6_di" bpmnElement="T6">
        <di:waypoint x="1080" y="610" />
        <di:waypoint x="1410" y="610" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="T8_di" bpmnElement="T8">
        <di:waypoint x="2120" y="570" />
        <di:waypoint x="2315" y="570" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="PoolTP" bpmnElement="Patient_Treatment" isHorizontal="true">
        <dc:Bounds x="160" y="790" width="3900" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PoolTE" bpmnElement="External_Treatment" isHorizontal="true">
        <dc:Bounds x="160" y="880" width="3900" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PoolPSP" bpmnElement="PSP" isHorizontal="true">
        <dc:Bounds x="160" y="970" width="3900" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Message_MF_CapacityRequest_di" bpmnElement="MF_CapacityRequest">
        <di:waypoint x="920" y="410" />
        <di:waypoint x="2110" y="915" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Message_MF_PaymentRequest_di" bpmnElement="MF_PaymentRequest">
        <di:waypoint x="2060" y="570" />
        <di:waypoint x="2110" y="1005" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Message_MF_PaymentStatus_di" bpmnElement="MF_PaymentStatus">
        <di:waypoint x="2110" y="1005" />
        <di:waypoint x="2340" y="570" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Message_MF_PaymentIssueNotice_di" bpmnElement="MF_PaymentIssueNotice">
        <di:waypoint x="2530" y="710" />
