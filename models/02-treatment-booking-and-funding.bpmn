<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_Treatment" targetNamespace="http://hospital.example/bpmn">
<bpmn:collaboration id="Collab_Treatment"><bpmn:participant id="Hospital_Treatment" name="Hospital Patient Administration System" processRef="Process_Treatment"/><bpmn:participant id="Patient_Treatment" name="Patient"/><bpmn:participant id="External_Treatment" name="External treatment and laboratory services"/><bpmn:participant id="PSP" name="External payment service provider"/></bpmn:collaboration>
<bpmn:process id="Process_Treatment" name="Treatment booking and funding" isExecutable="true"><bpmn:laneSet id="Lanes_Treatment"><bpmn:lane id="LT_Clinical" name="Consultant and authorised clinical professionals"><bpmn:flowNodeRef>S_Treatment</bpmn:flowNodeRef><bpmn:flowNodeRef>AuthoriseRequest</bpmn:flowNodeRef><bpmn:flowNodeRef>RequestAuthorised</bpmn:flowNodeRef><bpmn:flowNodeRef>UrgentOverride</bpmn:flowNodeRef><bpmn:flowNodeRef>E_Invalid</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="LT_Booking" name="Treatment and Chemotherapy Bookings Team"><bpmn:flowNodeRef>CheckCapacity</bpmn:flowNodeRef><bpmn:flowNodeRef>PendingExternal</bpmn:flowNodeRef><bpmn:flowNodeRef>RetryCapacity</bpmn:flowNodeRef><bpmn:flowNodeRef>ConfirmTreatment</bpmn:flowNodeRef><bpmn:flowNodeRef>E_Confirmed</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="LT_Finance" name="Finance Team"><bpmn:flowNodeRef>AssessFunding</bpmn:flowNodeRef><bpmn:flowNodeRef>FundingDecision</bpmn:flowNodeRef><bpmn:flowNodeRef>PaymentNeeded</bpmn:flowNodeRef><bpmn:flowNodeRef>TakePayment</bpmn:flowNodeRef><bpmn:flowNodeRef>PaymentOutcome</bpmn:flowNodeRef><bpmn:flowNodeRef>InvestigatePayment</bpmn:flowNodeRef><bpmn:flowNodeRef>NotifyPaymentIssue</bpmn:flowNodeRef><bpmn:flowNodeRef>E_Investigation</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
<bpmn:startEvent id="S_Treatment" name="Treatment booking request"/><bpmn:userTask id="AuthoriseRequest" name="Record consent and authorise request"/><bpmn:exclusiveGateway id="RequestAuthorised" name="Request authorised?"/><bpmn:endEvent id="E_Invalid" name="Unauthorised request stopped"/><bpmn:serviceTask id="CheckCapacity" name="Check treatment capacity"><bpmn:extensionElements><zeebe:taskDefinition type="treatment.capacity-check"/></bpmn:extensionElements></bpmn:serviceTask><bpmn:boundaryEvent id="ExternalUnavailable" attachedToRef="CheckCapacity" name="External service unavailable"><bpmn:errorEventDefinition/></bpmn:boundaryEvent><bpmn:userTask id="PendingExternal" name="Record pending booking and notify owner"/><bpmn:intermediateCatchEvent id="RetryCapacity" name="Retry after service recovery"><bpmn:timerEventDefinition><bpmn:timeDuration>PT30M</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent><bpmn:serviceTask id="AssessFunding" name="Assess funding arrangement"><bpmn:extensionElements><zeebe:taskDefinition type="funding.assess"/></bpmn:extensionElements></bpmn:serviceTask><bpmn:userTask id="FundingDecision" name="Record funding approval or limitation"/><bpmn:exclusiveGateway id="PaymentNeeded" name="Advance payment required?"/><bpmn:serviceTask id="TakePayment" name="Request secure payment"><bpmn:extensionElements><zeebe:taskDefinition type="payment.request"/></bpmn:extensionElements></bpmn:serviceTask><bpmn:exclusiveGateway id="PaymentOutcome" name="Payment outcome"/><bpmn:userTask id="InvestigatePayment" name="Investigate missing provider confirmation"/><bpmn:endEvent id="E_Investigation" name="Payment under investigation"/><bpmn:userTask id="NotifyPaymentIssue" name="Notify patient and responsible team"/><bpmn:userTask id="UrgentOverride" name="Authorise urgent treatment override"/><bpmn:userTask id="ConfirmTreatment" name="Confirm treatment appointments"/><bpmn:endEvent id="E_Confirmed" name="Treatment confirmed"/>
<bpmn:sequenceFlow id="T1" sourceRef="S_Treatment" targetRef="AuthoriseRequest"/><bpmn:sequenceFlow id="T2" sourceRef="AuthoriseRequest" targetRef="RequestAuthorised"/><bpmn:sequenceFlow id="T_Valid" name="yes" sourceRef="RequestAuthorised" targetRef="CheckCapacity"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=treatmentRequestAuthorised</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="T_Invalid" name="no" sourceRef="RequestAuthorised" targetRef="E_Invalid"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(treatmentRequestAuthorised)</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="T3" sourceRef="CheckCapacity" targetRef="AssessFunding"/><bpmn:sequenceFlow id="T_Error" sourceRef="ExternalUnavailable" targetRef="PendingExternal"/><bpmn:sequenceFlow id="T4" sourceRef="PendingExternal" targetRef="RetryCapacity"/><bpmn:sequenceFlow id="T5" sourceRef="RetryCapacity" targetRef="CheckCapacity"/><bpmn:sequenceFlow id="T6" sourceRef="AssessFunding" targetRef="FundingDecision"/><bpmn:sequenceFlow id="T7" sourceRef="FundingDecision" targetRef="PaymentNeeded"/><bpmn:sequenceFlow id="T_Funded" name="no payment" sourceRef="PaymentNeeded" targetRef="ConfirmTreatment"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(advancePaymentRequired)</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="T_Pay" name="payment required" sourceRef="PaymentNeeded" targetRef="TakePayment"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=advancePaymentRequired</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="T8" sourceRef="TakePayment" targetRef="PaymentOutcome"/><bpmn:sequenceFlow id="T_Success" name="completed" sourceRef="PaymentOutcome" targetRef="ConfirmTreatment"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentStatus = "completed"</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="T_Investigate" name="confirmation missing" sourceRef="PaymentOutcome" targetRef="InvestigatePayment"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentStatus = "investigate"</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="T9" sourceRef="InvestigatePayment" targetRef="E_Investigation"/><bpmn:sequenceFlow id="T_Fail" name="declined or cancelled" sourceRef="PaymentOutcome" targetRef="NotifyPaymentIssue"/><bpmn:sequenceFlow id="T10" sourceRef="NotifyPaymentIssue" targetRef="TakePayment"/><bpmn:sequenceFlow id="T_Urgent" name="urgent clinical risk" sourceRef="PaymentOutcome" targetRef="UrgentOverride"/><bpmn:sequenceFlow id="T11" sourceRef="UrgentOverride" targetRef="ConfirmTreatment"/><bpmn:sequenceFlow id="T12" sourceRef="ConfirmTreatment" targetRef="E_Confirmed"/></bpmn:process>
<bpmndi:BPMNDiagram id="Diagram_Treatment"><bpmndi:BPMNPlane id="Plane_Treatment" bpmnElement="Collab_Treatment"><bpmndi:BPMNShape id="PoolT" bpmnElement="Hospital_Treatment" isHorizontal="true"><dc:Bounds x="70" y="80" width="1900" height="480"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="LaneTC" bpmnElement="LT_Clinical"><dc:Bounds x="100" y="80" width="1870" height="160"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="LaneTB" bpmnElement="LT_Booking"><dc:Bounds x="100" y="240" width="1870" height="160"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="LaneTF" bpmnElement="LT_Finance"><dc:Bounds x="100" y="400" width="1870" height="160"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="PoolTP" bpmnElement="Patient_Treatment" isHorizontal="true"><dc:Bounds x="70" y="590" width="1900" height="70"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="PoolTE" bpmnElement="External_Treatment" isHorizontal="true"><dc:Bounds x="70" y="680" width="1900" height="70"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="PoolPSP" bpmnElement="PSP" isHorizontal="true"><dc:Bounds x="70" y="770" width="1900" height="70"/></bpmndi:BPMNShape></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>
